+def _shorten(text, limit):
+    """Fit `text` in `limit` characters, ending on a word and marked with "…".
+
+    Whole leading sentences are kept when they fit; otherwise the text is cut
+    at the last word that fits.
+    """
+    if len(text) <= limit:
+        return text
+    room = limit - len(ELLIPSIS)
+    head = text[:room + 1]
+    # Whole sentences, with a space before the marker.
+    ends = [m.end() for m in SENTENCE_END.finditer(head)
+            if m.end() + 1 <= room]
+    if ends:
+        return text[:ends[-1]].rstrip() + " " + ELLIPSIS
+    # Otherwise the last whole word that fits.
+    if text[room].isspace():
+        cut = text[:room]
+    else:
+        cut = text[:room].rsplit(None, 1)[0] if " " in text[:room] else text[:room]
+    return cut.rstrip(" ,;:-") + ELLIPSIS
 
 
