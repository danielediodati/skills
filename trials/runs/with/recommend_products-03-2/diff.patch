 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+_AMOUNT = r"\d+(?:[.,]\d{3})*(?:[.,]\d{1,2})?"
+_CURRENCY = r"(?:[€$£]|eur(?:o|os)?\b|usd\b|gbp\b|dollars?\b|pounds?\b)"
+# A figure is a price when a currency sits next to it, or when it is written
+# with two decimals ("19.90"). Other numbers ("2 m", "30-hour") are left alone.
+PRICE = re.compile(
+    rf"{_CURRENCY}\s*(?P<a>{_AMOUNT})(?![\d])"
+    rf"|(?<![\d.,])(?P<b>{_AMOUNT})\s*{_CURRENCY}"
+    rf"|(?<![\d.,])(?P<c>\d+[.,]\d{{2}})(?![\d])",
+    re.IGNORECASE,
+)
+
+
+def _to_float(text):
+    separators = [i for i, ch in enumerate(text) if ch in ".,"]
+    if not separators:
+        return float(text)
+    last = separators[-1]
+    tail = text[last + 1:]
+    # A lone separator followed by three digits groups thousands ("1,299").
+    if len(tail) == 3 and len(separators) == 1:
+        return float(text.replace(",", "").replace(".", ""))
+    whole = text[:last].replace(",", "").replace(".", "")
+    return float(f"{whole}.{tail}")
+
+
+def states_other_price(reason, price):
+    """True when `reason` quotes a price that differs from `price`."""
+    for match in PRICE.finditer(reason):
+        amount = match.group("a") or match.group("b") or match.group("c")
+        if abs(_to_float(amount) - price) >= 0.005:
+            return True
+    return False
 
 
 def recommend_products(query, catalog, model, limit=5):
