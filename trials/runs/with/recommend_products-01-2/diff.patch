+    def test_price_limit_in_the_search_drops_products_outside_it(self):
+        answer = "H-100 | Best sound\nH-200 | Cheap"
+        for query in ["headphones under 50", "headphones below 50", "headphones max 30 euro",
+                      "headphones up to €30", "headphones less than 20", "headphones between 5 and 40"]:
+            with self.subTest(query=query):
+                result = recommend(answer, query=query)
+                self.assertEqual([p["id"] for p in result], ["H-200"])
+
+    def test_lower_bounds_and_ranges(self):
+        answer = "H-100 | Best sound\nH-200 | Cheap"
+        for query in ["headphones over 100", "headphones from 100"]:
+            with self.subTest(query=query):
+                self.assertEqual([p["id"] for p in recommend(answer, query=query)], ["H-100"])
+        result = recommend("C-010 | a\nC-020 | b\nH-200 | c", query="between 8 and 20")
+        self.assertEqual([p["id"] for p in result], ["C-020", "H-200"])
+        result = recommend("C-010 | a\nC-020 | b\nH-200 | c", query="from 8 to 10")
+        self.assertEqual([p["id"] for p in result], ["C-020"])
+
+    def test_nothing_within_the_limit_gives_an_empty_list(self):
+        self.assertEqual(recommend("H-100 | Best sound", query="headphones under 5"), [])
