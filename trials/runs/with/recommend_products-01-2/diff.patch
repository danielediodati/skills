 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
 
-Products (ID | name | price | rating out of 5):
+{price_note}Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+_NUMBER = r"(?:[€$£]\s*)?(\d+(?:[.,]\d+)*)"
+_RANGE = re.compile(
+    rf"\b(?:between\s+{_NUMBER}\s+and|from\s+{_NUMBER}\s+to)\s+{_NUMBER}", re.I)
+# (pattern, is_upper_bound, inclusive)
+_BOUNDS = [
+    (re.compile(rf"\b(?:under|below|less\s+than|cheaper\s+than)\s+{_NUMBER}", re.I), True, False),
+    (re.compile(rf"\b(?:max|maximum|up\s+to|at\s+most|no\s+more\s+than|within)\s+{_NUMBER}", re.I), True, True),
+    (re.compile(rf"\b(?:over|above|more\s+than)\s+{_NUMBER}", re.I), False, False),
+    (re.compile(rf"\b(?:from|min|minimum|at\s+least)\s+{_NUMBER}", re.I), False, True),
+]
+
+
+def _amount(text):
+    """Read "29.90", "29,90", "1,000" or "1.500" as a number."""
+    parts = re.split(r"[.,]", text)
+    if len(parts) > 1 and len(parts[-1]) != 3:
+        return float("".join(parts[:-1]) + "." + parts[-1])
+    return float("".join(parts))
+
+
+def price_limits(query):
+    """Return the price range stated in `query` as a list of (is_upper, value, inclusive)."""
+    limits = []
+    match = _RANGE.search(query)
+    if match:
+        low, high = sorted(_amount(g) for g in match.groups() if g)
+        limits += [(False, low, True), (True, high, True)]
+        query = query[:match.start()] + " " + query[match.end():]
+    for pattern, is_upper, inclusive in _BOUNDS:
+        for match in pattern.finditer(query):
+            limits.append((is_upper, _amount(match.group(1)), inclusive))
+    return limits
+
+
+def within_limits(price, limits):
+    for is_upper, value, inclusive in limits:
+        if is_upper and (price > value or (price == value and not inclusive)):
+            return False
+        if not is_upper and (price < value or (price == value and not inclusive)):
+            return False
+    return True
 
 
 def recommend_products(query, catalog, model, limit=5):
