+_THOUSANDS_ONLY = " '’  "
+_SIGNS = {"-": "-", "−": "-", "+": ""}
+
+
+def _strip_affix(text):
+    """Remove currency codes, symbols and spaces from both ends of `text`."""
+    text = re.sub(r"^(?:\s|[^\W\d_]+\.?|[^\w\s.,'’+\-−])+", "", text)
+    return re.sub(r"(?:\s|[^\W\d_]+|[^\w\s.,'’+\-−])+$", "", text)
+
+
+def _plain_amount(value):
+    """Return `value` as a plain decimal string, "" if it is ambiguous, None if unreadable.
+
+    Accepts thousands separators (`,` `.` space or apostrophe), a decimal comma
+    or point, a sign, and a currency symbol or code on either side.
+    """
+    text = _strip_affix(value.strip())
+    sign = ""
+    if text[:1] in _SIGNS:
+        sign, text = _SIGNS[text[0]], text[1:]
+    elif text[-1:] in _SIGNS:
+        sign, text = _SIGNS[text[-1]], text[:-1]
+    text = _strip_affix(text.strip())
+    if not text or not re.fullmatch(r"[\d.,'’   ]+", text):
+        return None
+    if not text[0].isdigit() and text[0] not in ".,":
+        return None
+    seps = [c for c in text if not c.isdigit()]
+    if not seps:
+        return sign + text
+    kinds = set(seps)
+    if kinds & set(_THOUSANDS_ONLY) and len(kinds & set(_THOUSANDS_ONLY)) > 1:
+        return None
+    point = None  # the decimal separator, when there is one
+    if kinds <= set(_THOUSANDS_ONLY):
+        pass
+    elif kinds == {",", "."}:
+        point = text[max(text.rfind(","), text.rfind("."))]
+    elif len(kinds) == 1 and len(seps) == 1:
+        head, tail = text.split(seps[0])
+        if len(tail) == 3 and head not in ("", "0") and len(head) <= 3:
+            return ""
+        point = seps[0]
+    elif len(kinds) == 1:
+        pass  # repeated `.` or `,`: thousands
+    else:
+        point = (kinds & {",", "."}).pop()
+    if point is not None:
+        if text.count(point) != 1 or text.rfind(point) < max(map(text.rfind, kinds)):
+            return None
+        whole, _, fraction = text.partition(point)
+        if not fraction:
+            return None
+    else:
+        whole, fraction = text, ""
+    groups = re.split(r"[.,'’   ]", whole)
+    if len(set(c for c in whole if not c.isdigit())) > 1:
+        return None
+    if len(groups) > 1 and not (
+        1 <= len(groups[0]) <= 3 and all(len(g) == 3 for g in groups[1:])
+    ):
+        return None
+    if not groups[0] and len(groups) > 1:
+        return None
+    digits = "".join(groups) or "0"
+    return sign + digits + ("." + fraction if fraction else "")
+
+
