+def _calendar(meeting_date: date) -> str:
+    """The 14 days after the meeting, one per line."""
+    lines = []
+    for offset in range(1, 15):
+        day = meeting_date + timedelta(days=offset)
+        lines.append(f"  {day.strftime('%A')} {day.isoformat()}")
+    return "\n".join(lines)
+
