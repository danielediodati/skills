+_SEPARATORS = ".,'’   "
+_CURRENCY = r"(?:[^\W\d_]{1,4}\.?|[^\w\s.,'’+-]{1,2})"
+_WRITTEN_AMOUNT = re.compile(
+    rf"\s*(?P<sign1>[+-])?\s*(?:{_CURRENCY}\s*)?(?P<sign2>[+-])?\s*"
+    rf"(?P<number>\d+(?:[{_SEPARATORS}]\d+)*|[.,]\d+)"
+    rf"\s*(?:{_CURRENCY}\s*)?(?P<sign3>[+-])?\s*"
+)
+
+
+def _written_amount(text, label):
+    """Read an amount as a supplier writes it: grouping, decimal comma or point,
+    a currency symbol or code. Refuse what can be read two ways."""
+    match = _WRITTEN_AMOUNT.fullmatch(text)
+    if not match:
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+    signs = [match[g] for g in ("sign1", "sign2", "sign3") if match[g]]
+    if len(signs) > 1:
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+
+    number = re.sub("[  ]", " ", match["number"])
+    separators = re.findall(r"\D", number)
+    parts = re.split(r"\D", number)
+    points = {s for s in separators if s in ".,"}
+    groupers = {s for s in separators if s not in ".,"}
+
+    decimal_at = None  # index in `separators` of the decimal separator
+    if len(points) == 2:
+        # Both: the last is the decimal, the other only groups.
+        decimal_at = len(separators) - 1
+        if separators.count(separators[-1]) != 1:
+            raise InvoiceError(f"{label} is not a number: {text!r}")
+    elif len(points) == 1:
+        (point,) = points
+        if separators.count(point) > 1:
+            if groupers:
+                raise InvoiceError(f"{label} is not a number: {text!r}")
+            groupers = {point}
+        else:
+            decimal_at = separators.index(point)
+            before, after = parts[decimal_at], parts[decimal_at + 1]
+            if (not groupers and len(after) == 3
+                    and 1 <= len(before) <= 3 and before != "0"):
+                raise InvoiceError(f"{label} is ambiguous: {text!r}")
+    if len(groupers | {s for i, s in enumerate(separators)
+                        if s in ".," and i != decimal_at}) > 1:
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+
+    integer = parts if decimal_at is None else parts[:decimal_at + 1]
+    if len(integer) > 1 and not (1 <= len(integer[0]) <= 3
+                                 and all(len(p) == 3 for p in integer[1:])):
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+    digits = "".join(integer)
+    if decimal_at is not None:
+        digits += "." + parts[decimal_at + 1]
+    return Decimal(("-" if signs == ["-"] else "") + digits)
+
+
 def _cents(amount):
