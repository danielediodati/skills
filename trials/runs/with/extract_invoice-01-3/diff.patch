+_CURRENCY = r"(?:[A-Za-z]{3}|Fr\.|[$£€¥₹₽₩₪₺])"
+_MARKS = ".,'’   "
+_AMOUNT = re.compile(
+    rf"\s*(?P<sign1>[-+−])?\s*(?:{_CURRENCY}\s*)?(?P<sign2>[-+−])?\s*"
+    rf"(?P<body>\d(?:[\d{_MARKS}]*\d)?|[.,]\d+)\s*(?:{_CURRENCY})?\s*"
