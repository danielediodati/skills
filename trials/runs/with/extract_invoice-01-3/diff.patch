     return number
 
 
+def _written_amount(text, label):
+    """Read an amount as a supplier writes it: separators, symbol or code, sign.
+
+    Refuses what can be read two ways (`1.234`, `1,234`) instead of guessing.
+    """
+    match = _AMOUNT.fullmatch(text)
+    if not match or (match["sign1"] and match["sign2"]):
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+    parts = re.split(f"([{re.escape(_MARKS)}])", match["body"])
+    digits, marks = parts[0::2], parts[1::2]
+    if any(not group for group in digits[1:]) or (not digits[0] and len(marks) != 1):
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+
+    fraction = None
+    last = marks[-1] if marks else None
+    if last in (".", ","):
+        before = marks[:-1]
+        if last in before:
+            pass  # repeated: all thousands separators
+        elif not before and digits[0] and len(digits[1]) == 3                 and len(digits[0]) <= 3 and digits[0][0] != "0":
+            raise InvoiceError(
+                f"{label} is ambiguous, thousands or decimals: {text!r}")
+        else:
+            fraction = digits.pop()
+            marks = before
+    grouping = set(marks)
+    integer = digits
+    if len(grouping) > 1 or (
+            marks and (len(integer[0]) > 3 or any(len(g) != 3 for g in integer[1:]))):
+        raise InvoiceError(f"{label} is not a number: {text!r}")
+
+    number = Decimal("".join(integer) or "0")
+    if fraction:
+        number += Decimal(fraction).scaleb(-len(fraction))
+    if (match["sign1"] or match["sign2"]) in ("-", "−"):
+        number = -number
+    return number
+
+
 def _cents(amount):
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
