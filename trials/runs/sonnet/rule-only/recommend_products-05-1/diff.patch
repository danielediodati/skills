 Products (ID | name | price | rating out of 5):
 {products}
 """
 
+SENTENCE_END = re.compile(r"[.!?](?=\s|$)")
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+
+def fit_reason(reason):
+    """Return `reason` on one line if it fits, else its longest leading complete
+    sentences that fit, else "". It is never cut in the middle of a sentence."""
+    reason = " ".join(reason.split())
+    if len(reason) <= MAX_REASON_CHARS:
+        return reason
+    end = 0
+    for match in SENTENCE_END.finditer(reason):
+        if match.end() > MAX_REASON_CHARS:
+            break
+        end = match.end()
+    return reason[:end]
 
 
