+def _fit(body):
+    """Keep the start and the end of a long body, within MAX_BODY_CHARS."""
+    if len(body) <= MAX_BODY_CHARS:
+        return body
+    head = MAX_BODY_CHARS // 2
+    tail = MAX_BODY_CHARS - head
+    return body[:head] + "\n[... middle of the message omitted ...]\n" + body[-tail:]
+
