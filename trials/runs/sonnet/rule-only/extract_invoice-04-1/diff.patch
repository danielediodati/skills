+def _plain_decimal(text):
+    """Rewrite an amount as printed ('1.250,00', '1,250.00', '1 250,5') as '1250.00'.
+
+    Only unambiguous notations are rewritten; anything else is returned
+    unchanged, so that it is refused rather than guessed.
+    """
+    text = re.sub(r"[\s  ]", "", text)
+    if not re.fullmatch(r"[+-]?[\d.,]+", text):
+        return text
+    sign = text[0] if text[0] in "+-" else ""
+    body = text[len(sign):]
+    seps = [c for c in body if c in ".,"]
+    if not seps:
+        return text
+    last = seps[-1]
+    head, _, tail = body.rpartition(last)
+    other = "," if last == "." else "."
+    if len(set(seps)) == 2:
+        # Both separators: the last one is the decimal mark, the other groups thousands.
+        if last in head:
+            return text
+        groups = head.split(other)
+        if not all(len(g) == 3 for g in groups[1:]) or not groups[0]:
+            return text
+        return f"{sign}{''.join(groups)}.{tail}"
+    if seps.count(last) > 1:
+        # One separator repeated: it groups thousands ('1.250.000').
+        groups = body.split(last)
+        if all(len(g) == 3 for g in groups[1:]) and groups[0]:
+            return sign + "".join(groups)
+        return text
+    if last == ",":
+        # A lone comma is a decimal mark, unless it could be a thousands group.
+        if len(tail) == 3:
+            return text
+        return f"{sign}{head}.{tail}"
+    return text
+
+
