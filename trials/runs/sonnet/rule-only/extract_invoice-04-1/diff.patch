+    def test_continental_amounts_are_read(self):
+        lines = [{"description": "Tool", "quantity": 2, "unit_price": "2.340,50"}]
+        result = extract(lines=lines, total="4.681,00")
+        self.assertEqual(result["lines"][0]["unit_price"], Decimal("2340.50"))
+        self.assertEqual(result["total"], Decimal("4681.00"))
+        self.assertEqual(result["status"], "ok")
+
+    def test_amount_notations(self):
