+            ("1.250,00", "1250.00"), ("1,250.00", "1250.00"),
+            ("1 250,00", "1250.00"), ("12,5", "12.5"),
+            ("1.250.000", "1250000"), ("1,250,000", "1250000"),
+            ("-1.250,00", "-1250.00"), ("1250.00", "1250.00"),
+        ]:
