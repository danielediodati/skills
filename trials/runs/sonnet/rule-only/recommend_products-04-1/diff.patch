 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+The shop shows each product's price and rating next to your reason, so a reason must
+not state or imply a price, rating or ranking that differs from the list below.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+_NUMBER = r"(\d+(?:[.,]\d+)?)"
+_CURRENCY = r"(?:[$€£]\s*|(?=\d))"
+_CURRENCY_AFTER = r"(?:\s*(?:[$€£]|eur\b|euros?\b|usd\b|dollars?\b|gbp\b|pounds?\b))?"
+PRICE_LIMIT = re.compile(
+    r"\b(under|below|less than|cheaper than|over|above|more than|at least|up to|at most)\s+"
+    + _CURRENCY + _NUMBER + _CURRENCY_AFTER, re.I)
+PRICE_AMOUNT = re.compile(
+    r"(?:[$€£]\s*" + _NUMBER + r"|" + _NUMBER + r"\s*(?:[$€£]|eur\b|euros?\b|usd\b|dollars?\b|gbp\b|pounds?\b))",
+    re.I)
+RATING_AMOUNT = re.compile(
+    r"(?:\brated\s+" + _NUMBER + r"|" + _NUMBER + r"\s*(?:/\s*5\b|out of 5\b|stars?\b))", re.I)
+TOP_RATED = re.compile(r"\b(?:top|best|highest)[- ](?:rated|rating|reviewed)\b", re.I)
+CHEAPEST = re.compile(
+    r"\b(?:cheapest|lowest[- ]priced?|lowest price|best price|most affordable|least expensive)\b", re.I)
+PRICIEST = re.compile(r"\b(?:most expensive|priciest|highest[- ]priced?|highest price)\b", re.I)
+
+
+def _num(text):
+    return float(text.replace(",", "."))
+
+
+def _contradicts(reason, product, strip):
+    """True if `reason` states a price, rating or standing that `product` lacks.
+
+    `strip` is every product shown with it; standings are judged among those.
+    """
+    price, rating = product["price"], product["rating"]
+    lowered = reason.lower()
+    for kind, amount in PRICE_LIMIT.findall(reason):
+        limit = _num(amount)
+        kind = kind.lower()
+        if kind in ("under", "below", "less than", "cheaper than") and not price < limit:
+            return True
+        if kind in ("over", "above", "more than") and not price > limit:
+            return True
+        if kind in ("at least",) and not price >= limit:
+            return True
+        if kind in ("up to", "at most") and not price <= limit:
+            return True
+    limited = {m.span() for m in PRICE_LIMIT.finditer(reason)}
+    for m in PRICE_AMOUNT.finditer(reason):
+        if any(a <= m.start() and m.end() <= b for a, b in limited):
+            continue
+        if abs(_num(m.group(1) or m.group(2)) - price) >= 1:
+            return True
+    for m in RATING_AMOUNT.finditer(reason):
+        if abs(_num(m.group(1) or m.group(2)) - rating) >= 0.05:
+            return True
+    if TOP_RATED.search(lowered) and rating < max(p["rating"] for p in strip):
+        return True
+    if CHEAPEST.search(lowered) and price > min(p["price"] for p in strip):
+        return True
+    if PRICIEST.search(lowered) and price < max(p["price"] for p in strip):
+        return True
+    return False
 
 
