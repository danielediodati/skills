@@ -6,4 +6,6 @@
 
 The function returns a list of at most `limit` products, best first, each with `id`, `name`, `price`, `rating` and `reason` (one line of at most 80 characters, shown under the product). Only products that exist in the catalogue and are in stock are returned, each one once. A blank search, or a catalogue with nothing in stock, gives an empty list.
 
+The reason is the model's own words, but it is printed next to the real price and rating, so it is checked against them: a reason that states a figure that is neither the product's price or rating nor a true bound on them ("under 100" for a 129.00 product), or that claims to be the top-rated or cheapest when another product shown is better, is replaced by an empty reason. The check is a keyword and number match, not an understanding of the sentence; claims worded in other ways are not caught.
+
 Run the tests with `python -m unittest` from this directory.
--- a/seam.py
+++ b/seam.py
@@ -8,12 +8,57 @@
 
 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+The reason is shown next to the price and rating listed below, so anything it says about
+price, rating or how the product compares with the others must agree with those figures.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+NUMBER = re.compile(r"\d+(?:[.,]\d+)?")
+BOUND = re.compile(
+    r"(under|below|less than|up to|within|over|above|more than|at least)\s*\W{0,2}\s*$",
+    re.I,
+)
+UPPER_BOUNDS = ("under", "below", "less than", "up to", "within")
+TOP_RATED = re.compile(r"\b(?:(?:top|highest|best)[\s-]+rated|best[\s-]+reviewed)\b", re.I)
+CHEAPEST = re.compile(
+    r"\b(?:cheapest|lowest[\s-]+pric(?:e|ed)|best[\s-]+pric(?:e|ed)|most[\s-]+affordable)\b",
+    re.I,
+)
+VS_OTHERS = re.compile(
+    r"\b(?:cheaper|pricier|more expensive|better[\s-]+rated|higher[\s-]+rated|lower[\s-]+rated)\b",
+    re.I,
+)
+
+
+def _numbers_agree(reason, product):
+    """Every figure in `reason` is the product's price or rating, or a true bound on them."""
+    for match in NUMBER.finditer(reason):
+        value = float(match.group().replace(",", "."))
+        if abs(value - product["price"]) < 0.005 or abs(value - product["rating"]) < 0.005:
+            continue
+        bound = BOUND.search(reason[:match.start()])
+        if not bound:
+            return False
+        upper = bound.group(1).lower() in UPPER_BOUNDS
+        targets = [product["price"]] + ([product["rating"]] if value <= 5 else [])
+        if not all((t < value) if upper else (t > value) for t in targets):
+            return False
+    return True
+
+
+def _standing_agrees(reason, product, shown):
+    """Claims of being the top-rated or cheapest hold against the products shown."""
+    if VS_OTHERS.search(reason):
+        return False
+    if TOP_RATED.search(reason) and any(p["rating"] > product["rating"] for p in shown):
+        return False
+    if CHEAPEST.search(reason) and any(p["price"] < product["price"] for p in shown):
+        return False
+    return True
 
 
 def recommend_products(query, catalog, model, limit=5):
