 def _choice(value, allowed, default):
     value = (value or "").strip(" .*`\"'").lower()
     return value if value in allowed else default
+
+
+def _shorten(text, limit):
+    """Fit `text` in `limit` characters, never mid-word, marked with an ellipsis.
+
+    Whole leading sentences are kept when they fit; otherwise the text is cut
+    at the last word that fits.
+    """
+    if len(text) <= limit:
+        return text
+    room = limit - len(ELLIPSIS)
+
+    kept = ""
+    for sentence in SENTENCE_END.split(text):
+        candidate = f"{kept} {sentence}" if kept else sentence
+        if len(candidate) + 1 > room:  # +1: the space before the ellipsis
+            break
+        kept = candidate
+    if kept:
+        return f"{kept} {ELLIPSIS}"
+
+    cut = text[:room + 1]
+    if not cut[-1].isspace() and " " in cut:
+        cut = cut[:cut.rindex(" ")]
+    else:
+        cut = cut[:room]
+    cut = cut.rstrip(" ,;:-")
+    return cut + ELLIPSIS
