+def _date(data):
+    raw_date = _text(data, "issue_date")
+    try:
+        return date.fromisoformat(raw_date)
+    except ValueError:
+        raise InvoiceError(f"issue_date is not a date: {raw_date!r}") from None
+
+
+def _currency(data):
+    currency = _text(data, "currency").upper()
+    if not re.fullmatch(r"[A-Z]{3}", currency):
+        raise InvoiceError(f"currency is not a three-letter code: {currency!r}")
+    return currency
+
+
+def _line(raw, number, problems):
+    if not isinstance(raw, dict):
+        problems.append({"field": f"line {number}", "reason": f"line {number} is not an object"})
+        raw = {}
+    quantity = _try_number(raw.get("quantity"), f"line {number} quantity", problems)
+    unit_price = _try_number(raw.get("unit_price"), f"line {number} unit_price", problems)
+    amount = None
+    if quantity is not None and unit_price is not None:
+        amount = _cents(quantity * unit_price)
+    return {
+        "description": str(raw.get("description") or "").strip(),
+        "quantity": quantity,
+        "unit_price": unit_price,
+        "amount": amount,
+    }
+
+
+def _try_number(value, label, problems):
+    try:
+        return _number(value, label)
+    except InvoiceError as error:
+        problems.append({"field": label, "reason": str(error)})
+        return None
 
 
