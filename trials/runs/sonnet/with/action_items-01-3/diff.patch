 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, by_name: dict) -> Optional[str]:
+    """The attendee `text` names: in full, or by words that fit only one of them."""
+    key = _key(text)
+    if key in by_name:
+        return by_name[key]
+    words = key.split()
+    if not words or key in _EMPTY:
+        return None
+    matches = [
+        name for attendee, name in by_name.items() if set(words) <= set(attendee.split())
+    ]
+    return matches[0] if len(matches) == 1 else None
 
 
