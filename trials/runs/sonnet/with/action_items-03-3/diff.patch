 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _parse_owners(text: str, by_name: dict) -> Tuple[str, ...]:
+    """The attendees named in `text`, in order, each once; others are ignored."""
+    if _key(text) in by_name:  # the whole field is one name
+        return (by_name[_key(text)],)
+    owners: List[str] = []
+    for part in _OWNER_SEP.split(text):
+        name = by_name.get(_key(part))
+        if name and name not in owners:
+            owners.append(name)
+    return tuple(owners)
 
 
