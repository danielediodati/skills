 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# A number reads as a price when it carries a currency mark or has two decimals
+# ("14.90"); "2 m", "30-hour" and "4.5 stars" are other numbers and pass.
+_NUMBER = r"\d+(?:[.,]\d{3})*(?:[.,]\d{1,2})?"
+_CURRENCY = r"(?:[€$£]|\b(?:eur|usd|gbp)\b|\beuros?\b|\bdollars?\b|\bpounds?\b)"
+PRICE_CLAIM = re.compile(
+    rf"{_CURRENCY}\s*(?P<a>{_NUMBER})(?![\d])"
+    rf"|(?<![\d.,])(?P<b>{_NUMBER})\s*{_CURRENCY}"
+    r"|(?<![\d.,])(?P<c>\d+[.,]\d{2})(?![\d])",
+    re.IGNORECASE,
+)
+
+
+def _to_amount(text):
+    match = re.search(r"[.,](\d{1,2})$", text)
+    if match:
+        whole = re.sub(r"[.,]", "", text[:match.start()])
+        return float(f"{whole}.{match.group(1)}")
+    return float(re.sub(r"[.,]", "", text))
+
+
+def states_other_price(reason, price):
+    """True if `reason` quotes a price that is not `price`."""
+    for match in PRICE_CLAIM.finditer(reason):
+        text = match.group("a") or match.group("b") or match.group("c")
+        if abs(_to_amount(text) - price) >= 0.005:
+            return True
+    return False
 
 
