+def _without_quoted_replies(body):
+    """Drop what a mail program quotes from earlier messages: `>` lines and
+    the "On <date>, <name> wrote:" line that introduces them (which some
+    programs wrap over two lines). Done before the cap so that quoted text
+    cannot push the customer's new words out of what the model sees."""
+    body = ATTRIBUTION.sub("", body)
+    lines = [line for line in body.splitlines() if not line.lstrip().startswith(">")]
+    return "\n".join(lines).strip()
+
