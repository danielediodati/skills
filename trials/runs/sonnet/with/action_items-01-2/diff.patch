 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _match_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """The attendee `text` names, or None if it names nobody or more than one.
+
+    A full name matches as written; otherwise the words of `text` (say, a first
+    name) must all be words of exactly one attendee's name.
+    """
+    key = _key(text)
+    if key in _EMPTY:
+        return None
+    for name in attendees:
+        if _key(name) == key:
+            return name
+    words = set(key.split())
+    found = [name for name in attendees if words <= set(_key(name).split())]
+    return found[0] if len(found) == 1 else None
 
 
