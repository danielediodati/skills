 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+_NUMBER = (
+    r"€?\s*(\d+(?:[.,]\d+)*)"
+    r"(?:\s*(?:€|\beuros?\b|\beur\b))?"
+    r"(?!\s*(?:mm|cm|km|kg|gb|tb|mb|mah|hz|ml|inch|m|g|w|l)\b)"
+)
+_RANGE = re.compile(
+    rf"\b(?:between|from)\s+{_NUMBER}\s+(?:and|to)\s+{_NUMBER}", re.IGNORECASE)
+# (pattern, True when the stated number itself is still allowed)
+_UPPER = [
+    (re.compile(rf"\b(?:under|below|less\s+than|cheaper\s+than)\s+{_NUMBER}", re.IGNORECASE), False),
+    (re.compile(rf"\b(?:max|maximum|up\s+to|at\s+most|no\s+more\s+than)\.?\s+{_NUMBER}", re.IGNORECASE), True),
+]
+_LOWER = [
+    (re.compile(rf"\b(?:over|above|more\s+than)\s+{_NUMBER}", re.IGNORECASE), False),
+    (re.compile(rf"\b(?:from|min|minimum|at\s+least)\.?\s+{_NUMBER}", re.IGNORECASE), True),
+]
+
+
+def _amount(text):
+    if re.fullmatch(r"\d{1,3}(?:,\d{3})+(?:\.\d+)?", text):
+        text = text.replace(",", "")
+    return float(text.replace(",", "."))
+
+
+def price_bounds(query):
+    """Return the price limits stated in `query` as a predicate on a price.
+
+    Understands "under 50", "max 30 euro", "up to €30", "over 100",
+    "from 100", "between 20 and 40" and the like. A query with no price
+    accepts every price.
+    """
+    checks = []
+    for match in _RANGE.finditer(query):
+        low, high = sorted((_amount(match.group(1)), _amount(match.group(2))))
+        checks.append(lambda price, low=low, high=high: low <= price <= high)
+    rest = _RANGE.sub(" ", query)
+    for pattern, inclusive in _UPPER:
+        for match in pattern.finditer(rest):
+            limit = _amount(match.group(1))
+            checks.append(
+                lambda price, limit=limit, inclusive=inclusive:
+                price <= limit if inclusive else price < limit)
+    for pattern, inclusive in _LOWER:
+        for match in pattern.finditer(rest):
+            limit = _amount(match.group(1))
+            checks.append(
+                lambda price, limit=limit, inclusive=inclusive:
+                price >= limit if inclusive else price > limit)
+    return lambda price: all(check(price) for check in checks)
 
 
