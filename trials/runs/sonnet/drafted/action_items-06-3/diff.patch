+def _calendar(meeting_date: date) -> str:
+    """The 14 days after the meeting, one per line, with their weekday."""
+    lines = []
+    for offset in range(1, 15):
+        day = meeting_date + timedelta(days=offset)
+        lines.append(f"{_WEEKDAYS[day.weekday()]} {day.isoformat()}")
+    return "\n".join(lines)
+
+
 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
 
