+def _calendar(meeting_date: date, days: int = 21) -> str:
+    """One line per day from the meeting on, weekday first, grouped by week."""
+    lines = []
+    for offset in range(days):
+        day = meeting_date + timedelta(days=offset)
+        lines.append(f"{_WEEKDAYS[day.weekday()]} {day.isoformat()}")
+        if day.weekday() == 6 and offset != days - 1:
+            lines.append("")  # blank line between weeks
+    return "\n".join(lines)
+
