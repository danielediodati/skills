+    def test_amounts_as_suppliers_write_them_are_read(self):
+        cases = {
+            "1.234,56": "1234.56",
+            "1,234.56": "1234.56",
+            "£1,234.56": "1234.56",
+            "1'050.00 CHF": "1050.00",
+            "EUR 1 234,56": "1234.56",
+            "1.234.567,89": "1234567.89",
+            "1,234,567": "1234567",
+            "12,5": "12.5",
+            "1234,567": "1234.567",
+            "0.335": "0.335",
+            "-€12,50": "-12.50",
+            "(12.50)": "-12.50",
+            "$ 99": "99",
+        }
+        for written, expected in cases.items():
+            with self.subTest(written):
+                lines = [{"description": "x", "quantity": 1, "unit_price": written}]
+                result = extract(lines=lines, total=expected)
+                self.assertEqual(result["lines"][0]["unit_price"], Decimal(expected))
+
+    def test_total_with_currency_and_thousands_is_read(self):
+        lines = [{"description": "x", "quantity": 1, "unit_price": "1234.56"}]
+        self.assertEqual(extract(lines=lines, total="£1,234.56")["status"], "ok")
+
+    def test_ambiguous_amounts_are_refused(self):
+        for written in ["1,234", "1.234", "£1.234", "1,23.456", "1.234,56,7", "12 EUR 5", "1 234.5.6"]:
+            with self.subTest(written):
+                with self.assertRaisesRegex(InvoiceError, "total is not a number"):
+                    extract(total=written)
