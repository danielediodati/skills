+def _parse_amount(text, label):
+    """Read an amount as suppliers write it: `1.234,56`, `£1,234.56`, `1'050.00 CHF`.
+
+    A lone separator followed by exactly three digits (`1,234`) could be a thousands
+    separator or a decimal one; it is refused rather than guessed.
+    """
+    fail = InvoiceError(f"{label} is not a number: {text!r}")
+    s = text.strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1].strip()
+    # Peel currency symbols, codes, spaces and signs off both ends.
+    signs = 0
+    while s:
+        first, last = s[0], s[-1]
+        if first in "-−" or last in "-−":
+            signs += 1
+            s = s[1:] if first in "-−" else s[:-1]
+        elif first in "+" or first.isspace() or first.isalpha() or unicodedata.category(first) == "Sc":
+            s = s[1:]
+        elif last in "+" or last.isspace() or last.isalpha() or unicodedata.category(last) == "Sc":
+            s = s[:-1]
+        else:
+            break
+    if signs > 1 or not re.fullmatch(r"[\d.,'’   ]*\d[\d.,'’   ]*|[.,]\d+", s):
+        raise fail
+    negative = negative or signs == 1
+
+    grouped = re.search(r"['’   ]", s) is not None
+    if grouped:
+        if re.search(r"[.,]['’   ]|['’   ][.,]", s):
+            raise fail
+        groups = re.split(r"['’   ]+", s)
+        # The last group may carry one decimal separator.
+        tail = re.split(r"[.,]", groups[-1])
+        if len(tail) > 2:
+            raise fail
+        groups[-1:] = tail[:1]
+        integer, fraction = groups, tail[1] if len(tail) == 2 else ""
+        if not _grouped_by_three(integer):
+            raise fail
+        integer_digits = "".join(integer)
+    else:
+        marks = [c for c in s if c in ".,"]
+        if not marks:
+            integer_digits, fraction = s, ""
+        elif len(set(marks)) == 2:
+            decimal = marks[-1]
+            if marks.count(decimal) != 1:
+                raise fail
+            whole, fraction = s.split(decimal)
+            groups = whole.split(marks[0])
+            if not _grouped_by_three(groups):
+                raise fail
+            integer_digits = "".join(groups)
+        elif len(marks) > 1:
+            groups = s.split(marks[0])
+            if not _grouped_by_three(groups):
+                raise fail
+            integer_digits, fraction = "".join(groups), ""
+        else:
+            whole, fraction = s.split(marks[0])
+            if len(fraction) == 3 and 1 <= len(whole) <= 3 and whole != "0":
+                raise InvoiceError(
+                    f"{label} is not a number: {text!r} (separator is ambiguous)")
+            integer_digits = whole
+    digits = f"{integer_digits or '0'}.{fraction or '0'}"
+    number = Decimal(digits)
+    return -number if negative else number
+
+
+def _grouped_by_three(groups):
+    return (len(groups[0]) in (1, 2, 3) and groups[0].isdigit()
+            and all(len(g) == 3 and g.isdigit() for g in groups[1:]))
+
+
