+def _without_quotes(body):
+    """Drop lines quoted from earlier messages, so the cap is spent on new text.
+
+    A body made only of quotes is returned unchanged.
+    """
+    kept = [
+        line for line in body.splitlines()
+        if not QUOTE_LINE.match(line) and not ATTRIBUTION.match(line)
+    ]
+    return "\n".join(kept).strip() or body
+
