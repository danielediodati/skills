+def _without_quoted_lines(body):
+    # Mail programs prefix the earlier messages with ">"; dropped before the
+    # cap so a long quote cannot push the new text out of the body.
+    lines = [l for l in body.splitlines() if not l.lstrip().startswith(">")]
+    return "\n".join(lines).strip()
