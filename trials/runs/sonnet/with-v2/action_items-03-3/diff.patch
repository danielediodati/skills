 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _parse_owners(text: str, by_name: dict) -> Tuple[str, ...]:
+    """The attendees named in `text`; a name that is not an attendee is dropped."""
+    whole = by_name.get(_key(text))
+    if whole is not None:  # also covers a name that itself contains a separator
+        return (whole,)
+    owners: List[str] = []
+    for part in _SEPARATORS.split(text):
+        name = by_name.get(_key(part))
+        if name is not None and name not in owners:
+            owners.append(name)
+    return tuple(owners)
 
 
