+def _without_quotes(body):
+    """Drop the earlier messages a mail program quotes in a reply.
+
+    Removes lines starting with `>` and the "On <date>, <name> wrote:"
+    line that introduces them, wherever they sit in the body, so that
+    the model and the length cap see only what the customer just wrote.
+    """
+    lines = body.splitlines()
+    drop = [bool(QUOTED.match(line)) for line in lines]
+    for i, line in enumerate(lines):
+        if drop[i] or not WROTE.search(line):
+            continue
+        following = next((j for j in range(i + 1, len(lines)) if lines[j].strip()), None)
+        if following is not None and drop[following]:
+            drop[i] = True
+            # An attribution wrapped over two lines starts with "On ".
+            if i > 0 and lines[i - 1].lstrip().lower().startswith("on "):
+                drop[i - 1] = True
+    return "\n".join(line for line, d in zip(lines, drop) if not d).strip()
+
