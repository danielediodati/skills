+_CURRENCY_MARK = "(?:[A-Z]{3}|[£€$¥₹₩₽¢₣])"
+_SIGNS = "-−"
+_SPACES = "[ '’  ]"
+
+
+def _parse_amount(text):
+    """Read an amount as suppliers write it: `1.234,56`, `£1,234.56`, `1'050.00 CHF`.
+
+    Raises InvalidOperation when the text is not an amount, and ValueError when
+    it can be read two ways (`1.234` is one thousand two hundred thirty-four or
+    one and a bit).
+    """
+    body, negative = text.strip(), False
+    while body:
+        before = body
+        if body[0] == "(" and body[-1] == ")":
+            body, negative = body[1:-1].strip(), True
+        if body and body[0] in _SIGNS + "+":
+            negative = negative or body[0] in _SIGNS
+            body = body[1:].strip()
+        elif body and body[-1] in _SIGNS:
+            negative, body = True, body[:-1].strip()
+        body = re.sub(rf"^{_CURRENCY_MARK}\s*|\s*{_CURRENCY_MARK}$", "", body)
+        if body == before:
+            break
+    if not re.fullmatch(rf"\d(?:\d|[.,]|{_SPACES})*", body):
+        raise InvalidOperation
+
+    # Spaces and apostrophes only ever group thousands.
+    parts = re.split(_SPACES + "+", body)
+    grouped = len(parts) > 1
+    if grouped:
+        if not (re.fullmatch(r"\d{1,3}", parts[0])
+                and all(re.fullmatch(r"\d{3}", p) for p in parts[1:-1])
+                and re.fullmatch(r"\d{3}(?:[.,]\d+)?", parts[-1])):
+            raise InvalidOperation
+        body = "".join(parts)
+
+    marks = [c for c in body if c in ".,"]
+    if len(set(marks)) == 2:
+        # The mark written last is the decimal one; the other must group thousands.
+        decimal_mark = marks[-1]
+        group_mark = "," if decimal_mark == "." else "."
+        whole, _, fraction = body.rpartition(decimal_mark)
+        if decimal_mark in whole or group_mark in fraction:
+            raise InvalidOperation
+        amount = _grouped(whole, group_mark) + "." + _digits(fraction)
+    elif len(marks) > 1:
+        # One mark repeated can only be grouping: `1.234.567`.
+        if grouped:
+            raise InvalidOperation
+        amount = _grouped(body, marks[0])
+    elif marks:
+        whole, _, fraction = body.partition(marks[0])
+        _digits(whole), _digits(fraction)
+        if len(fraction) == 3 and not grouped and whole != "0" and len(whole) <= 3:
+            raise ValueError(
+                f"can be read as {whole}{fraction} or as {whole}.{fraction}")
+        amount = whole + "." + fraction
+    else:
+        amount = body
+    number = Decimal(amount)
+    return -number if negative else number
+
+
+def _digits(text):
+    if not text.isdigit():
+        raise InvalidOperation
+    return text
+
+
+def _grouped(text, mark):
+    groups = text.split(mark)
+    if not (re.fullmatch(r"\d{1,3}", groups[0])
+            and all(re.fullmatch(r"\d{3}", g) for g in groups[1:])):
+        raise InvalidOperation
+    return "".join(groups)
+
