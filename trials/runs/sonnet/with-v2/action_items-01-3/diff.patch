 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _unique_first_names(attendees: Sequence[str]) -> dict:
+    """Map a first name to its attendee, only where one attendee has it."""
+    firsts: dict = {}
+    for name in attendees:
+        parts = _key(name).split(" ")
+        firsts.setdefault(parts[0], set()).add(name)
+    return {first: next(iter(names)) for first, names in firsts.items() if len(names) == 1}
 
 
