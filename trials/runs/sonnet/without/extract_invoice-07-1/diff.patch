+def _squash(value):
+    return " ".join(value.lower().split())
+
+
+def _date_readings(raw, date_order):
+    """Return every date `raw` can mean; one entry when it is unambiguous."""
+    value = _squash(raw)
+    if match := re.fullmatch(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})", value):
+        orders = [(match[1], match[2], match[3])]
+    elif match := re.fullmatch(r"(\d{1,2})([./-])(\d{1,2})\2(\d{4}|\d{2})", value):
+        first, second, year = match[1], match[3], match[4]
+        if match[2] == "." or date_order == "DMY":
+            orders = [(year, second, first)]
+        elif date_order == "MDY":
+            orders = [(year, first, second)]
+        else:
+            orders = [(year, second, first), (year, first, second)]
+    else:
+        words = re.sub(r"(?<=\d)(st|nd|rd|th)\b|[,.]|\bof\b", " ", value).split()
+        day = month = year = None
+        for word in words:
+            if word in MONTHS:
+                month = MONTHS[word]
+            elif word.isdigit() and len(word) == 4:
+                year = word
+            elif word.isdigit() and len(word) <= 2:
+                day = word
+        if not (day and month and year) or len(words) != 3:
+            raise InvoiceError(f"issue_date_text is not a date: {raw!r}")
+        orders = [(year, str(month), day)]
+    found = []
+    for year, month, day in orders:
+        year = int(year) + 2000 if len(year) == 2 else int(year)
+        try:
+            reading = date(year, int(month), int(day))
+        except ValueError:
+            continue
+        if reading not in found:
+            found.append(reading)
+    if not found:
+        raise InvoiceError(f"issue_date_text is not a date: {raw!r}")
+    return found
 
 
