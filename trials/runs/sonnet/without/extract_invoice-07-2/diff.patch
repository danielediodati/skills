+def _date_candidates(printed):
+    """Dates the printed text can mean: one if clear, [day-first, month-first] if not."""
+    words = printed.strip().lower().replace(",", " ")
+    try:
+        match = re.fullmatch(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})", words)
+        if match:
+            year, month, day = map(int, match.groups())
+            return [date(year, month, day)]
+        match = re.fullmatch(r"(\d{1,2})[-/. ](\d{1,2})[-/. ](\d{2}|\d{4})", words)
+        if match:
+            first, second, year = map(int, match.groups())
+            year += 2000 if year < 100 else 0
+            options = []
+            for day, month in ((first, second), (second, first)):
+                try:
+                    options.append(date(year, month, day))
+                except ValueError:
+                    pass
+            return sorted(set(options), key=options.index)
+        match = re.fullmatch(r"(?:\w+day )?(\d{1,2})(?:st|nd|rd|th)?(?: of)?[ -]+([a-z]+)\.?[ -]+(\d{4})", words)
+        if match and match.group(2) in MONTHS:
+            return [date(int(match.group(3)), MONTHS[match.group(2)], int(match.group(1)))]
+        match = re.fullmatch(r"(?:\w+day )?([a-z]+)\.? +(\d{1,2})(?:st|nd|rd|th)?[ ]+(\d{4})", words)
+        if match and match.group(1) in MONTHS:
+            return [date(int(match.group(3)), MONTHS[match.group(1)], int(match.group(2)))]
+    except ValueError:
+        pass
+    return []
 
 
