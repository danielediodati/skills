+def _shorten(text, limit):
+    """Fit `text` in `limit` characters, never ending mid-word.
+
+    A text that had to be shortened ends with an ellipsis. Whole leading
+    sentences are kept when they fit, otherwise whole words.
+    """
+    if len(text) <= limit:
+        return text
+    room = limit - len(ELLIPSIS)
+
+    kept = ""
+    for sentence in SENTENCE_END.split(text):
+        candidate = f"{kept} {sentence}" if kept else sentence
+        if len(candidate) > room:
+            break
+        kept = candidate
+    if kept:
+        return kept + ELLIPSIS
+
+    cut = text[:room + 1]
+    if not text[room].isspace():
+        # The cut falls inside a word: drop that word.
+        head, space, _ = cut.rpartition(" ")
+        cut = head if space else cut[:room]
+    return cut.rstrip().rstrip(",;:-") + ELLIPSIS
 
 
