+def _calendar(meeting_date: date, days: int = 15) -> str:
+    lines = []
+    for offset in range(days):
+        day = meeting_date + timedelta(days=offset)
+        note = " (day of the meeting)" if offset == 0 else ""
+        lines.append(f"{day.strftime('%A')} {day.isoformat()}{note}")
+    return "\n".join(lines)
+
+
 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
 
