 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# Amounts in a reason that read as a price: next to a currency, written with two
+# decimals, or right after a word like "at" or "only" (and not followed by a unit).
+_CURRENCY = r"(?:€|\$|£|\b(?:eur|euros?|usd|dollars?|gbp|pounds?)\b)"
+_NUMBER = r"(\d+(?:[.,]\d+)*)(?!\d|[.,]\d)"
+_PRICE_MENTIONS = [
+    re.compile(_CURRENCY + r"\s*" + _NUMBER, re.I),
+    re.compile(_NUMBER + r"\s*" + _CURRENCY, re.I),
+    re.compile(r"(?<![\d.,])(\d+[.,]\d{2})(?!\d)"),
+    re.compile(r"\b(?:at|for|only|just|costs?|price[ds]?(?:\s+at)?)\s+"
+               + _NUMBER + r"(?!\s*[a-z-])", re.I),
+]
+
+
+def _to_amount(text):
+    """Parse "1,299.00", "14,90" or "4" into a float."""
+    match = re.search(r"[.,](\d{1,2})$", text)
+    if match:
+        whole = re.sub(r"[.,]", "", text[:match.start()])
+        return float(f"{whole}.{match.group(1)}")
+    return float(re.sub(r"[.,]", "", text))
+
+
+def _quotes_other_price(reason, price):
+    for pattern in _PRICE_MENTIONS:
+        for text in pattern.findall(reason):
+            if abs(_to_amount(text) - price) >= 0.005:
+                return True
+    return False
 
 
 def recommend_products(query, catalog, model, limit=5):
