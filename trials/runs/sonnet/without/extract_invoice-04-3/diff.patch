+def _plain_number(value, label):
+    """Rewrite an amount as printed ("1.250,00", "1,250.00", "1 250,00") with a plain point.
+
+    A lone separator followed by exactly three digits ("1.250") could be a
+    thousands group or a decimal fraction, so it is refused rather than guessed.
+    """
+    text = re.sub(r"^[^\d+\-.,]+|[^\d]+$", "", value.strip())
+    text = re.sub(r"(?<=\d)[   '’](?=\d{3}(?!\d))", "", text)
+    sign, body = re.fullmatch(r"([+-]?)(.*)", text).groups()
+    if not body:
+        return text
+    if "." in body and "," in body:
+        decimal = "." if body.rfind(".") > body.rfind(",") else ","
+        group = "," if decimal == "." else "."
+        if not re.fullmatch(rf"\d{{1,3}}(?:\{group}\d{{3}})+\{decimal}\d+", body):
+            return text
+        body = body.replace(group, "").replace(decimal, ".")
+    else:
+        for separator in ".,":
+            count = body.count(separator)
+            if not count:
+                continue
+            if count > 1:
+                if not re.fullmatch(rf"\d{{1,3}}(?:\{separator}\d{{3}})+", body):
+                    return text
+                body = body.replace(separator, "")
+            else:
+                head, tail = body.split(separator)
+                if len(tail) == 3 and re.fullmatch(r"[1-9]\d{0,2}", head):
+                    raise InvoiceError(
+                        f"{label} is ambiguous, thousands or decimals: {value!r}"
+                    )
+                body = head + "." + tail
+    return sign + body
+
