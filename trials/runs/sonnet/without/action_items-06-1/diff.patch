+_WEEKDAYS = {
+    name: number
+    for number, names in enumerate(
+        [
+            ("monday", "mon"),
+            ("tuesday", "tue", "tues"),
+            ("wednesday", "wed"),
+            ("thursday", "thu", "thur", "thurs"),
+            ("friday", "fri"),
+            ("saturday", "sat"),
+            ("sunday", "sun"),
+        ]
+    )
+    for name in names
+}
+_FRIDAY = 4
+_LEAD = re.compile(r"^(?:(?:by|before|on|until|for|at|the)\s+)+")
+_IN_N = re.compile(r"^in (\d+|a|one|two|three|four) (day|week)s?$")
+_NUMBER_WORDS = {"a": 1, "one": 1, "two": 2, "three": 3, "four": 4}
+
+
+def _resolve_relative(text: str, meeting_date: date) -> Optional[date]:
+    """Resolve phrases such as "Friday" or "end of next week"; None if unknown.
+
+    Weeks run Monday to Sunday. A bare weekday is its next occurrence after
+    the meeting day; "next <weekday>" is that day in the following week; the
+    end of a week is its Friday.
+    """
+    phrase = _LEAD.sub("", _key(text).rstrip(".!"))
+    monday = meeting_date - timedelta(days=meeting_date.weekday())
+
+    if phrase in {"today", "end of day", "eod", "end of the day", "close of business", "cob"}:
+        return meeting_date
+    if phrase == "tomorrow":
+        return meeting_date + timedelta(days=1)
+    if phrase in {"end of week", "end of the week", "end of this week", "eow"}:
+        return monday + timedelta(days=_FRIDAY)
+    if phrase in {"next week", "end of next week"}:
+        return monday + timedelta(weeks=1, days=_FRIDAY)
+
+    match = _IN_N.match(phrase)
+    if match:
+        count = int(match[1]) if match[1].isdigit() else _NUMBER_WORDS[match[1]]
+        unit = 1 if match[2] == "day" else 7
+        return meeting_date + timedelta(days=count * unit)
+
+    words = phrase.split()
+    if words and words[0] in {"this", "next"} and len(words) == 2:
+        weekday = _WEEKDAYS.get(words[1])
+        if weekday is None:
+            return None
+        week = monday + timedelta(weeks=1 if words[0] == "next" else 0)
+        return week + timedelta(days=weekday)
+    if len(words) == 1 and words[0] in _WEEKDAYS:
+        ahead = (_WEEKDAYS[words[0]] - meeting_date.weekday()) % 7 or 7
+        return meeting_date + timedelta(days=ahead)
+    return None
