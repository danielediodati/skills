+class RelativeDueTest(unittest.TestCase):
+    def due(self, phrase, meeting=MEETING):
+        item = extract_action_items(
+            "n", ATTENDEES, meeting, FakeModel(f"Do it | Ana Ruiz | {phrase}")
+        )[0]
+        return item.due
+
+    def test_weekday_is_the_next_one_after_the_meeting(self):
+        self.assertEqual(self.due("by Friday"), date(2026, 3, 6))
+        self.assertEqual(self.due("Thursday"), date(2026, 3, 5))
+        self.assertEqual(self.due("Monday"), date(2026, 3, 9))
+
+    def test_same_weekday_as_the_meeting_means_a_week_later(self):
+        self.assertEqual(self.due("Tuesday"), date(2026, 3, 10))
+
+    def test_end_of_next_week_is_next_friday(self):
+        self.assertEqual(self.due("end of next week"), date(2026, 3, 13))
+        self.assertEqual(self.due("End of next week"), date(2026, 3, 13))
+
+    def test_end_of_this_week_and_next_weekday(self):
+        self.assertEqual(self.due("end of the week"), date(2026, 3, 6))
+        self.assertEqual(self.due("next Friday"), date(2026, 3, 13))
+        self.assertEqual(self.due("next Monday"), date(2026, 3, 9))
+
+    def test_tomorrow_and_in_n_days(self):
+        self.assertEqual(self.due("tomorrow"), date(2026, 3, 4))
+        self.assertEqual(self.due("in 2 weeks"), date(2026, 3, 17))
+        self.assertEqual(self.due("in three days"), date(2026, 3, 6))
+
+    def test_unknown_phrase_is_none(self):
+        self.assertIsNone(self.due("when the budget is approved"))
+
+    def test_prompt_asks_for_relative_deadlines_verbatim(self):
+        model = FakeModel("NONE")
+        extract_action_items(NOTES, ATTENDEES, MEETING, model)
+        self.assertIn("copy those words exactly", model.prompts[0])
+
