 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, by_name: dict, notes: str) -> Optional[str]:
+    key = _key(text)
+    if key in _EMPTY:
+        return None
+    if key in by_name:
+        return by_name[key]
+    # Not an attendee: trust the name only if the notes actually contain it.
+    words = r"\s+".join(re.escape(w) for w in key.split())
+    pattern = r"\b" + words + r"\b"
+    if re.search(pattern, notes, re.IGNORECASE):
+        return " ".join(text.split())
+    return None
 
 
