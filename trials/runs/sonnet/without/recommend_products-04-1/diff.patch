+
+    def test_reason_with_wrong_figure_or_number_word_is_dropped(self):
+        for reason in ("Only 99", "Rated 5 stars", "Under a hundred", "20% off", "Over 4.9 stars"):
+            self.assertEqual(recommend("H-100 | " + reason)[0]["reason"], "", reason)
