+def _fit_body(body):
+    """Shorten a long body, keeping its beginning and its end.
+
+    The request is often at the end (under a quoted thread or a pasted log),
+    so cutting off the tail would hide it.
+    """
+    if len(body) <= MAX_BODY_CHARS:
+        return body
+    head = MAX_BODY_CHARS // 2
+    tail = MAX_BODY_CHARS - head
+    return body[:head] + OMISSION_MARKER + body[-tail:]
+
+
