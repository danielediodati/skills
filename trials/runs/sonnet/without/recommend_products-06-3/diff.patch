+        reasons = {p["id"]: p["reason"] for p in _parse(followup, available)}
+        for p in missing:
+            p["reason"] = reasons.get(p["id"], "")
+
+    picks = [p for p in wanted if p["reason"]]
+    for p in candidates[limit:]:
+        if len(picks) == limit:
+            break
+        if p["reason"]:
+            picks.append(p)
+    return picks
+
