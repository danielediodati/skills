     return picks
+
+
+def _parse(answer, allowed):
+    """Return (id, reason) for each line naming a new ID found in `allowed`."""
+    found = []
+    seen = set()
+    for line in answer.splitlines():
+        product_id, _, reason = LIST_MARKER.sub("", line).partition("|")
+        product_id = product_id.strip()
+        # The model may invent an ID or repeat one: only real, new ones count.
+        if product_id not in allowed or product_id in seen:
+            continue
+        seen.add(product_id)
+        found.append((product_id, " ".join(reason.split())))
+    return found
+
+
+def _fit(reason):
+    """Return `reason` if it fits, else its longest leading run of whole
+    sentences that fits, else None."""
+    if len(reason) <= MAX_REASON_CHARS:
+        return reason
+    ends = [m.end() for m in SENTENCE_END.finditer(reason)
+            if m.end() <= MAX_REASON_CHARS]
+    return reason[:ends[-1]] if ends else None
