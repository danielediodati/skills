+class _Ambiguous(Exception):
+    """The amount can be read as two different numbers."""
+
+
+_SYMBOLS = re.escape("".join(
+    c for c in map(chr, range(sys.maxunicode + 1)) if unicodedata.category(c) == "Sc"
+))
+_CURRENCY = rf"(?:[A-Za-z]{{3}}|[A-Za-z]{{0,2}}[{_SYMBOLS}]+)"
+# Apostrophes, space, no-break space, narrow no-break space.
+_GROUPING = "'’   "
+_AMOUNT = re.compile(
+    rf"\s*(?P<s1>[+-])?\s*(?:{_CURRENCY}\s*)?(?P<s2>[+-])?\s*"
+    rf"(?P<num>[\d.,][\d.,{_GROUPING}]*\d|\d)\s*(?P<s3>-)?\s*(?:{_CURRENCY})?\s*"
+)
+_EXPONENT = re.compile(r"[+-]?\d+(?:\.\d+)?[eE][+-]?\d+")
+
+
+def _parse_amount(text):
+    """Read an amount as printed: thousands separators, a decimal comma or
+    point, a currency symbol or code. Return None if it is not an amount and
+    raise _Ambiguous if it could be read as two different numbers."""
+    text = text.strip()
+    if _EXPONENT.fullmatch(text):
+        return Decimal(text)
+    match = _AMOUNT.fullmatch(text)
+    if not match:
+        return None
+    signs = [match[g] for g in ("s1", "s2", "s3") if match[g]]
+    if len(signs) > 1:
+        return None
+    integer, fraction = _split_digits(match["num"])
+    if integer is None:
+        return None
+    number = Decimal(f"{integer}.{fraction}" if fraction else integer)
+    return -number if signs == ["-"] else number
+
+
+def _grouped(parts):
+    """The digits if `parts` is one to three digits then groups of three."""
+    head, rest = parts[0], parts[1:]
+    if re.fullmatch(r"\d{1,3}", head) and all(re.fullmatch(r"\d{3}", p) for p in rest):
+        return "".join(parts)
+    return None
+
+
+def _split_digits(num):
+    """Return (integer digits, fraction digits) of `num`, or (None, None)."""
+    bad = (None, None)
+    if any(c in _GROUPING for c in num):
+        # A space or apostrophe is only ever a thousands separator, so what
+        # follows the last group can only be a decimal part.
+        parts = re.split(f"[{_GROUPING}]+", num)
+        last = re.fullmatch(r"(\d{3})(?:[.,](\d+))?", parts[-1])
+        if len(parts) < 2 or not last:
+            return bad
+        integer = _grouped(parts[:-1] + [last[1]])
+        return (integer, last[2] or "") if integer else bad
+    kinds = {c for c in num if c in ".,"}
+    if not kinds:
+        return num, ""
+    if len(kinds) == 2:
+        # Both present: the last one is the decimal separator.
+        decimal = num[max(num.rfind("."), num.rfind(","))]
+        thousands = "," if decimal == "." else "."
+        head, _, fraction = num.rpartition(decimal)
+        if not fraction.isdigit() or decimal in head:
+            return bad
+        integer = _grouped(head.split(thousands))
+        return (integer, fraction) if integer else bad
+    sep = kinds.pop()
+    if num.count(sep) > 1:
+        integer = _grouped(num.split(sep))
+        return (integer, "") if integer else bad
+    head, _, tail = num.partition(sep)
+    if not tail.isdigit() or (head and not head.isdigit()):
+        return bad
+    if len(tail) == 3 and 1 <= len(head) <= 3 and head != "0":
+        raise _Ambiguous  # 1.234 or 1,234: thousands or three decimals
+    return head or "0", tail
+
