@@ -8,12 +8,35 @@
 
 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+Do not mention prices, ratings, or how products compare on price or rating: the shop
+shows those figures itself.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# The shop shows price and rating next to the reason, so a reason must not state
+# or compare them in its own words: the model can get them wrong, and a printed
+# price that differs from the one charged misleads shoppers. The reason is free
+# text we cannot verify, so any wording that touches these is rejected and the
+# pick is shown with no reason (the figures are printed beside it anyway).
+FIGURES_OR_CURRENCY = re.compile(r"[\d£$€¥]")
+PRICE_RATING_STANDING = re.compile(
+    r"\b(?:"
+    r"cheap\w*|afford\w*|budget|bargain|pric\w*|cost\w*|pay|save|saving\w*|"
+    r"discount\w*|deal|value|worth|under|below|above|less|than|"
+    r"pounds?|dollars?|euros?|cash|free|fiver|tenner|quid|bucks|grand|"
+    r"rated|ratings?|stars?|reviews?|reviewed|scores?|highest|lowest|number one|"
+    r"ten|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred|thousand"
+    r")\b",
+    re.IGNORECASE,
+)
+
+
+def _states_price_or_rating(reason):
+    return bool(FIGURES_OR_CURRENCY.search(reason) or PRICE_RATING_STANDING.search(reason))
 
 
 def recommend_products(query, catalog, model, limit=5):
