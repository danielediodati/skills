 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text, by_name, notes_key):
+    key = _key(text)
+    if key in _EMPTY:
+        return None, True
+    if key in by_name:
+        return by_name[key], True
+    # Not an attendee: believe the model only if the notes really name them.
+    if re.search(r"(?<!\w)" + re.escape(key) + r"(?!\w)", notes_key):
+        return " ".join(text.split()), False
+    return None, True
 
 
