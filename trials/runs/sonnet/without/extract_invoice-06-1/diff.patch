+    def test_flat_charge_is_one_unit_at_its_amount(self):
+        lines = [
+            {"description": "40 steel brackets", "quantity": 40, "unit_price": "6.25"},
+            {"description": "Delivery", "quantity": None, "unit_price": None,
+             "amount": "35.00"},
+        ]
+        result = extract(lines=lines, total="285.00")
+        self.assertEqual(result["lines"][1], {
+            "description": "Delivery",
+            "quantity": Decimal("1"),
+            "unit_price": Decimal("35.00"),
+            "amount": Decimal("35.00"),
+        })
+        self.assertEqual(result["lines_total"], Decimal("285.00"))
+        self.assertEqual(result["status"], "ok")
+
+    def test_flat_charge_with_keys_absent(self):
+        lines = [{"description": "Annual support fee", "amount": 1200}]
+        result = extract(lines=lines, total=1200)
+        self.assertEqual(result["lines"][0]["amount"], Decimal("1200.00"))
+        self.assertEqual(result["status"], "ok")
+
+    def test_line_with_nothing_but_a_description_is_an_error(self):
+        lines = [{"description": "Delivery"}]
+        with self.assertRaisesRegex(InvoiceError, "line 1 quantity is missing"):
+            extract(lines=lines)
