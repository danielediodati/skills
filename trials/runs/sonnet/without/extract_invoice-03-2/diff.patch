+class _Unreadable(Exception):
+    """One field is missing (reason "missing") or malformed (any other reason)."""
+
+
+def _problem(field, raw, error):
+    reason = str(error)
+    problem = {"field": field, "reason": reason}
+    if reason != "missing":
+        problem["value"] = raw
+    return problem
+
+
+def _line(number, raw, problems):
+    line = {"description": None, "quantity": None, "unit_price": None, "amount": None}
+    if not isinstance(raw, dict):
+        problems.append(_problem(f"line {number}", raw, _Unreadable("not an object")))
+        return line
+    line["description"] = str(raw.get("description") or "").strip()
+    for key in ("quantity", "unit_price"):
+        try:
+            line[key] = _number(raw.get(key))
+        except _Unreadable as error:
+            problems.append(_problem(f"line {number} {key}", raw.get(key), error))
+    if line["quantity"] is not None and line["unit_price"] is not None:
+        line["amount"] = _cents(line["quantity"] * line["unit_price"])
+    return line
 
 
