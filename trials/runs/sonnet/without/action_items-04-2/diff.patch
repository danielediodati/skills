 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _tokens(name: str) -> List[str]:
+    return re.findall(r"\w+", name.casefold())
+
+
+def _token_matches(given: str, full: str) -> bool:
+    if given == full:
+        return True
+    if len(given) == 1:  # an initial, as in "Ana R."
+        return full.startswith(given)
+    # A short form or a longer one, as in "Tom" / "Tommy".
+    return min(len(given), len(full)) >= 3 and (
+        full.startswith(given) or given.startswith(full)
+    )
+
+
+def _match_attendee(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """The one attendee that `text` plainly refers to, else None.
+
+    Accepts a first or last name alone, a short form or nickname that starts
+    like the real name, and an initial. If two attendees fit, nobody is named.
+    """
+    given = _tokens(text)
+    if not given or " ".join(given) in _EMPTY or all(len(g) == 1 for g in given):
+        return None
+    found = [
+        name
+        for name in attendees
+        if all(any(_token_matches(g, f) for f in _tokens(name)) for g in given)
+    ]
+    return found[0] if len(found) == 1 else None
 
 
