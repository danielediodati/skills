+def _drop_quoted(body):
+    """Remove lines an email client quoted (">"), unless nothing else is left."""
+    kept = [line for line in body.splitlines() if not line.lstrip().startswith(">")]
+    text = "\n".join(kept).strip()
+    return text or body
+
+
+def _fit(body, limit):
+    """Shorten an over-long body by cutting the middle, keeping both ends."""
+    if len(body) <= limit:
+        return body
+    tail = int(limit * TAIL_SHARE)
+    head = limit - tail
+    return body[:head] + "\n[...]\n" + body[-tail:]
+
+
 def _parse_fields(answer):
