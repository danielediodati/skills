+def redact_secrets(text):
+    """Replace card numbers, security codes and passwords in `text`.
+
+    This is pattern based and errs towards removing too much. It cannot recognise
+    a password that is given without a cue word such as "password" or "PIN".
+    """
+    text = CARD_NUMBER.sub(REDACTED, text)
+    text = SECURITY_CODE.sub(lambda m: m.group(1) + m.group(2) + REDACTED, text)
+    return PASSWORD.sub(_redact_password, text)
+
+
+def _redact_password(match):
+    sep = match.group("sep")
+    bare = match.group("bare")
+    # "password reset" style wording is left alone; "password: x" never is.
+    if bare and not sep.strip() and bare.rstrip(".!?").lower() in NOT_A_PASSWORD:
+        return match.group(0)
+    # Keep trailing sentence punctuation outside the removed value.
+    tail = bare[len(bare.rstrip(".!?")):] if bare else ""
+    return match.group(1) + sep + REDACTED + tail
 
 
