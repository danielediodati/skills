+def _quantity_and_price(raw, number):
+    # A flat charge (delivery, setup fee) is one amount with no quantity: it
+    # counts as one unit. A line that has a quantity but no price is still an error.
+    quantity, unit_price = raw.get("quantity"), raw.get("unit_price")
+    if quantity is None and unit_price is None and raw.get("amount") is not None:
+        unit_price = raw["amount"]
+    if quantity is None and unit_price is not None:
+        quantity = 1
+    return (
+        _number(quantity, f"line {number} quantity"),
+        _number(unit_price, f"line {number} unit_price"),
+    )
+
+
 def _cents(amount):
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
