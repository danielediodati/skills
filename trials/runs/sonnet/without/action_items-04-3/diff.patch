 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """Return the attendee `text` names, or None if none or several fit."""
+    if _key(text) in _EMPTY:
+        return None
+    for name in attendees:
+        if _key(name) == _key(text):
+            return name
+    # "Tom" or "Ana R." name someone only if exactly one attendee fits.
+    words = re.findall(r"\w+", text.casefold())
+    if not words:
+        return None
+    matches = [name for name in attendees if _fits(words, name)]
+    return matches[0] if len(matches) == 1 else None
+
+
+def _fits(words: List[str], name: str) -> bool:
+    """Every word is a part of `name` or the initial of one; at least one in full."""
+    parts = re.findall(r"\w+", name.casefold())
+    full = False
+    for word in words:
+        if word in parts:
+            full = True
+        elif len(word) == 1 and any(part.startswith(word) for part in parts):
+            continue
+        else:
+            return False
+    return full
 
 
