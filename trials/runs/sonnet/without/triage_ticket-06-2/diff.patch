+def _redact(text):
+    """Replace card numbers, security codes and passwords with placeholders."""
+    text = CARD_NUMBER.sub("[card number removed]", text)
+    text = SECURITY_CODE.sub(lambda m: m.group(1) + " [removed]", text)
+
+    def credential(match):
+        value = match.group("value")
+        # Without "is"/":"/"=" or quotes, only mask values that look like
+        # secrets, so "forgot my password and can't log in" stays readable.
+        explicit = match.group("link").strip() or value[0] in "\"'“`"
+        if explicit or re.search(r"[\d\W_]", value.strip(".,;!?")):
+            return match.group(1) + match.group("link") + "[removed]"
+        return match.group(0)
+
+    return CREDENTIAL.sub(credential, text)
 
 
