+
+# Secrets that customers paste into messages. The summary is shown to every
+# agent, on the wall screen and in emailed reports, so these must never reach
+# it. Over-redacting is cheap; leaking is not.
+CARD_NUMBER = re.compile(r"(?<![\w-])\d(?:[ -]?\d){12,18}(?![\w-])")
+SECURITY_CODE = re.compile(
+    r"\b(cvc2?|cvv2?|csc|security code)\b(\W{0,3}(?:is|was)\W{0,3}|\W{0,3})\d{3,4}\b",
+    re.IGNORECASE,
+)
+CREDENTIAL = re.compile(
+    r"\b(password|passcode|passphrase|passwd|pwd|pin)\b"
+    r"(?P<link>\s*(?:is|was|:|=)\s*|\s+)"
+    r"(?P<value>[\"'“`][^\"'”`]+[\"'”`]|\S+)",
+    re.IGNORECASE,
+)
 
