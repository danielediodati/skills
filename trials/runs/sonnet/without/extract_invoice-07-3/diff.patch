+def _issue_date(data, text, date_order):
+    """Return (date or None, candidate dates), reading the date as printed.
+
+    The model's own YYYY-MM-DD is not trusted: it has already chosen a
+    day/month order, so the printed string is parsed here instead.
+    """
+    printed = _text(data, "issue_date_as_printed")
+    if " ".join(printed.split()) not in " ".join(text.split()):
+        raise InvoiceError(f"issue_date_as_printed is not in the invoice: {printed!r}")
+
+    numeric = re.fullmatch(r"(\d{1,4})([/.\-])(\d{1,2})\2(\d{1,4})", printed)
+    if numeric:
+        first, sep, second, third = numeric.groups()
+        if len(first) == 4:  # year first (ISO style): no ambiguity
+            triples = [(first, second, third)]
+        else:
+            if sep == "." and date_order is None:
+                date_order = "DMY"  # dotted dates are day-first by convention
+            pairs = {"DMY": [(first, second)], "MDY": [(second, first)],
+                     None: [(first, second), (second, first)]}[date_order]
+            triples = [(third, month, day) for day, month in pairs]
+        found = set()
+        for year, month, day in triples:
+            year = int(year) + (2000 if len(year) <= 2 else 0)
+            try:
+                found.add(date(year, int(month), int(day)))
+            except ValueError:
+                pass
+        found = sorted(found)
+    else:
+        found = _named_month_date(printed)
+    if not found:
+        raise InvoiceError(f"issue_date is not a date: {printed!r}")
+    return (found[0] if len(found) == 1 else None), found
+
+
+def _named_month_date(printed):
+    """Read dates like '2 Oct 2026' or 'October 2, 2026'; month names are unambiguous."""
+    lowered = printed.lower()
+    month = next((i for i, name in enumerate(MONTHS, 1)
+                  if re.search(rf"(?<![a-z]){name}", lowered)), None)
+    numbers = re.findall(r"\d+", printed)
+    if month is None or len(numbers) != 2:
+        return []
+    day, year = (int(n) for n in sorted(numbers, key=len))
+    if year < 100:
+        year += 2000
+    try:
+        return [date(year, month, day)]
+    except ValueError:
+        return []
 
 
