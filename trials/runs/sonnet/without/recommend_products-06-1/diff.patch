+REASON_PROMPT = """A customer of an online shop searched for: {query}
+
+For each product below, write one short reason it is worth their attention for this
+search, addressed to the customer. If it is not a perfect match, say how it differs
+or what it is good for.
+Answer with one product per line, as: ID | one short reason
+
+Products (ID | name | price | rating out of 5):
+{products}
+"""
+
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+
+def _product_line(p):
+    return f"{p['id']} | {p['name']} | {p['price']:.2f} | {p['rating']}"
+
+
+def _parse_reasons(answer, wanted):
+    """Map product ID -> cleaned reason for the IDs in `wanted`, first mention wins."""
+    reasons = {}
+    for line in answer.splitlines():
+        product_id, _, reason = LIST_MARKER.sub("", line).partition("|")
+        product_id = product_id.strip()
+        reason = " ".join(reason.split())[:MAX_REASON_CHARS]
+        if product_id in wanted and product_id not in reasons and reason:
+            reasons[product_id] = reason
+    return reasons
 
 
