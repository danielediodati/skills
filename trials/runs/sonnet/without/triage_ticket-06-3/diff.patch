 def _choice(value, allowed, default):
     value = (value or "").strip(" .*`\"'").lower()
     return value if value in allowed else default
+
+
+def _redact(text, secrets):
+    """Replace card numbers, security codes and passwords in `text`.
+
+    Passwords found are appended to `secrets`; every secret already in
+    `secrets` is removed wherever it appears.
+    """
+    def password(match):
+        value = match.group("quoted") or match.group("token")
+        trailing = ""
+        if match.group("token"):
+            value = match.group("token").rstrip(".!?)\"'")
+            trailing = match.group("token")[len(value):]
+        stated = match.group("open") or match.group("sep").strip()
+        # "password reset" is not a password; "password Tulip-Harbour-92" is.
+        if not value or not (stated or any(not c.isalpha() and c != "'" for c in value)):
+            return match.group(0)
+        if len(value) >= 4 and value not in secrets:
+            secrets.append(value)
+        return match.group("kw") + match.group("sep") + REMOVED + trailing
+
+    text = PASSWORD.sub(password, text)
+    for secret in secrets:
+        text = text.replace(secret, REMOVED)
+    text = SECURITY_CODE.sub(lambda m: m.group(1) + m.group(2) + REMOVED, text)
+    return CARD_NUMBER.sub("[card number]", text)
