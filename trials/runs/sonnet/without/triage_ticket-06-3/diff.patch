+    def test_card_number_and_cvc_are_removed_from_summary(self):
+        result = triage(
+            "queue: billing\nurgency: high\nsummary: Wants the duplicate charge "
+            "on card 4539 1488 0343 6467 (CVC 318) reversed."
+        )
+        self.assertNotIn("4539", result["summary"])
+        self.assertNotIn("6467", result["summary"])
+        self.assertNotIn("318", result["summary"])
+
+    def test_password_is_removed_from_summary(self):
+        result = triage(
