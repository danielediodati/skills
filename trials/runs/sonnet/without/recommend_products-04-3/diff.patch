         with self.assertRaises(ValueError):
             recommend("H-100 | Best sound", limit=0)
 
+    def reasons(self, answer, query="cable"):
+        return {p["id"]: p["reason"] for p in recommend(answer, query=query)}
+
+    def test_reason_promising_a_price_the_product_lacks_is_blanked(self):
+        for reason in ("Great sound for under 100", "Only 99.00", "Just €89 today",
+                       "Under €100 and wireless"):
+            self.assertEqual(self.reasons("H-100 | " + reason)["H-100"], "", reason)
+
+    def test_reason_with_the_true_price_or_bound_is_kept(self):
+        for reason in ("Great sound for 129.00", "Under 150 for wireless sound",
+                       "Over 100 well spent", "Only €129"):
+            self.assertEqual(self.reasons("H-100 | " + reason)["H-100"], reason, reason)
+
+    def test_reason_with_a_wrong_rating_is_blanked(self):
+        for reason in ("Rated 4.9 by shoppers", "4.9/5 stars", "Over 4.8 stars"):
+            self.assertEqual(self.reasons("H-100 | " + reason)["H-100"], "", reason)
+        self.assertEqual(self.reasons("H-100 | Rated 4.7 out of 5")["H-100"],
+                         "Rated 4.7 out of 5")
+
+    def test_top_rated_claim_must_hold_within_the_strip(self):
+        got = self.reasons("C-010 | Our top-rated cable\nC-020 | Our top-rated cable")
+        self.assertEqual(got, {"C-010": "", "C-020": "Our top-rated cable"})
+
+    def test_cheapest_claim_must_hold_within_the_strip(self):
+        got = self.reasons("C-010 | The cheapest option\nC-020 | The cheapest option")
+        self.assertEqual(got, {"C-010": "The cheapest option", "C-020": ""})
+
+    def test_comparisons_that_cannot_be_checked_are_blanked(self):
+        self.assertEqual(self.reasons("C-020 | Cheaper than the others")["C-020"], "")
+
+    def test_numbers_that_are_not_prices_or_ratings_are_kept(self):
+        got = self.reasons("C-010 | Sturdy 1 m braided cable, under 2 m of slack")
+        self.assertEqual(got["C-010"], "Sturdy 1 m braided cable, under 2 m of slack")
+        self.assertEqual(self.reasons("H-100 | 30 hour battery")["H-100"], "30 hour battery")
+
 
 if __name__ == "__main__":
     unittest.main()
