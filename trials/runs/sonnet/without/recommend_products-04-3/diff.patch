 """Pick the products to show a shopper for a search, each with a short reason."""
 
 import re
+import statistics
 
 MAX_REASON_CHARS = 80
 
@@ -8,12 +9,139 @@
 
 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+The reason must not state or hint at a price, a rating, or how the product compares with the
+others on price or rating: those are shown separately. Talk about what the product is and does.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# A reason is free text written by the model, so what it says about price, rating
+# or standing is checked against the figures shown for the product. A reason that
+# makes a claim we cannot confirm is shown as an empty one rather than kept.
+# Whole-word match: the text is lowercased, so "cheap" must not match "cheapest".
+B0 = r"(?<![a-z])"
+B1 = r"(?![a-z])"
+NUM = r"\d+(?:,\d{3})*(?:[.,]\d+)?"
+RATING_NUM = r"\d(?:[.,]\d)?"
+UNITS = {
+    "m", "cm", "mm", "km", "g", "kg", "h", "hr", "hrs", "hour", "hours", "min", "mins",
+    "minute", "minutes", "sec", "secs", "s", "day", "days", "week", "weeks", "month",
+    "months", "year", "years", "gb", "tb", "mb", "w", "watt", "watts", "hz", "khz", "db",
+    "mah", "ft", "inch", "inches", "in", "%", "x", "pack", "pcs", "pieces", "reviews",
+    "review", "ratings", "customers", "users", "people", "sold", "stars", "star",
+}
+CURRENCY_WORD = r"(?:€|(?:eur|euros?|usd|dollars?|pounds?|gbp|quid)" + B1 + r")"
+PRICE_BOUND = re.compile(
+    B0 + r"(?P<word>under|below|less than|beneath|up to|within|over|above|more than)\s+"
+    r"(?P<cur>[$€£])?\s*(?P<n>" + NUM + r")(?P<tail>\s*" + CURRENCY_WORD + r")?"
+)
+PRICE_EXACT = re.compile(
+    r"(?:[$€£]\s*(?P<a>" + NUM + r")|(?P<b>" + NUM + r")\s*" + CURRENCY_WORD + r"|"
+    + B0 + r"(?:for|only|just|at|costs?|priced at|price of|price is|price:)\s+(?P<c>"
+    + NUM + r"))"
+)
+RATING_CLAIM = re.compile(
+    B0 + r"(?:(?P<word>over|above|more than|at least|under|below|less than)\s+)?"
+    r"(?P<n>" + RATING_NUM + r")(?P<plus>\+)?[\s-]*(?:/\s*5|out of 5|stars?" + B1 + r"|★)"
+    r"|" + B0 + r"rated\s+(?:at\s+)?(?P<m>" + RATING_NUM + r")(?![\d.]*\d)"
+    r"|" + B0 + r"rating\s*(?:of|is|:)?\s*(?P<r>" + RATING_NUM + r")(?![\d.]*\d)"
+)
+UNVERIFIABLE = re.compile(
+    B0 + r"(cheaper|pricier|more expensive|less expensive|more affordable|higher rated|"
+    r"better rated|lower rated|rated higher|best value|better value|"
+    r"than the (?:others|rest|other))" + B1
+)
+
+
+def _number(text):
+    if re.fullmatch(r"\d{1,3}(?:,\d{3})+(?:\.\d+)?", text):
+        return float(text.replace(",", ""))
+    return float(text.replace(",", "."))
+
+
+def _is_unit_next(text, end):
+    following = re.match(r"[\s-]*(%|[a-z]+)", text[end:])
+    return bool(following) and following.group(1) in UNITS
+
+
+def _price_claims_hold(text, price):
+    covered = []
+    for m in PRICE_BOUND.finditer(text):
+        has_currency = bool(m.group("cur") or m.group("tail"))
+        if not has_currency and _is_unit_next(text, m.end("n")):
+            continue
+        covered.append(m.span())
+        n = _number(m.group("n"))
+        word = m.group("word")
+        if word in ("under", "below", "less than", "beneath"):
+            ok = price < n
+        elif word in ("up to", "within"):
+            ok = price <= n
+        else:
+            ok = price > n
+        if not ok:
+            return False
+    for m in PRICE_EXACT.finditer(text):
+        if any(s < m.end() and m.start() < e for s, e in covered):
+            continue
+        raw = m.group("a") or m.group("b") or m.group("c")
+        if m.group("c") and _is_unit_next(text, m.end("c")):
+            continue
+        if round(_number(raw), 2) != round(price, 2):
+            return False
+    return True
+
+
+def _rating_claims_hold(text, rating):
+    for m in RATING_CLAIM.finditer(text):
+        n = _number(m.group("n") or m.group("m") or m.group("r"))
+        word = m.group("word")
+        if word in ("under", "below", "less than"):
+            ok = rating < n
+        elif word in ("over", "above", "more than"):
+            ok = rating > n
+        elif word == "at least" or m.group("plus"):
+            ok = rating >= n
+        else:
+            ok = abs(rating - n) < 1e-9
+        if not ok:
+            return False
+    return True
+
+
+def _standing_claims_hold(text, product, picks):
+    """Superlatives and "cheap"-style words are judged against the strip shown."""
+    prices = [p["price"] for p in picks]
+    ratings = [p["rating"] for p in picks]
+    price, rating = product["price"], product["rating"]
+    median = statistics.median(prices)
+    checks = [
+        (r"(cheapest|lowest priced|lowest price|least expensive|best price)",
+         price == min(prices)),
+        (r"(most expensive|priciest|highest priced|highest price)",
+         price == max(prices)),
+        (r"(top rated|best rated|highest rated|highest rating|best rating|"
+         r"top rating|most highly rated)", rating == max(ratings)),
+        (r"(lowest rated|lowest rating|worst rated)", rating == min(ratings)),
+        (r"(cheap|inexpensive|affordable|budget|bargain|low cost|low priced)",
+         price <= median),
+        (r"(?<!least )(?<!less )(expensive|pricey)", price >= median),
+    ]
+    return all(ok for pattern, ok in checks if re.search(B0 + pattern + B1, text))
+
+
+def _reason_agrees(reason, product, picks):
+    text = re.sub(r"[-–‐]", " ", reason.lower())
+    if UNVERIFIABLE.search(text):
+        return False
+    return (
+        _price_claims_hold(text, product["price"])
+        and _rating_claims_hold(text, product["rating"])
+        and _standing_claims_hold(text, product, picks)
+    )
 
 
 def recommend_products(query, catalog, model, limit=5):
