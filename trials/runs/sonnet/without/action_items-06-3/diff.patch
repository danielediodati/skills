+def _resolve_phrase(text: str, meeting_date: date) -> Optional[date]:
+    """Resolve a deadline written the way people say it, relative to the meeting.
+
+    Weeks run Monday to Sunday and "the end of" a week is its Friday. A bare
+    weekday is its next occurrence after the meeting day ("by Friday" on a
+    Tuesday is that week's Friday); "next <weekday>" is that day in the
+    following week. Phrases that are not understood give None.
+    """
+    phrase = _key(text).strip(" .,;")
+    phrase = re.sub(r"^(?:by|on|before|until|for)\s+", "", phrase)
+    phrase = re.sub(r"^(?:the )?end of (?:the )?day$|^eod$|^cob$", "today", phrase)
+    monday = meeting_date - timedelta(days=meeting_date.weekday())
+
+    if phrase in ("today", "tonight"):
+        return meeting_date
+    if phrase == "tomorrow":
+        return meeting_date + timedelta(days=1)
+    if phrase in ("end of week", "end of the week", "end of this week",
+                  "the end of this week", "the end of the week"):
+        return monday + timedelta(days=4)
+    if phrase in ("next week", "end of next week", "the end of next week"):
+        return monday + timedelta(days=11)
+    if phrase in ("end of month", "end of the month", "end of this month",
+                  "the end of the month", "the end of this month"):
+        last = calendar.monthrange(meeting_date.year, meeting_date.month)[1]
+        return meeting_date.replace(day=last)
+
+    match = re.fullmatch(_DAY, phrase.removeprefix("this "))
+    if match:
+        ahead = (_WEEKDAYS[match.group(1)] - meeting_date.weekday()) % 7
+        return meeting_date + timedelta(days=ahead or 7)
+    match = re.fullmatch(r"next " + _DAY, phrase)
+    if match:
+        return monday + timedelta(days=7 + _WEEKDAYS[match.group(1)])
+    match = re.fullmatch(r"(?:in )?(\d+|a|an|one|two|three|four|five) (day|week)s?"
+                         r"(?: from now| time)?", phrase)
+    if match:
+        count = _NUMBERS.get(match.group(1)) or int(match.group(1))
+        return meeting_date + timedelta(days=count * _UNITS[match.group(2)])
+    return None
