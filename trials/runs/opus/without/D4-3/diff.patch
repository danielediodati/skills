+def live(thread: str, negotiation: str, run: str, moved: str, waiting: bool) -> runs.Live:
+    return runs.Live(thread, negotiation, run, moved, waiting, {})
+
+
+def closed(negotiation: str, run: str, ending: str) -> runs.Run:
+    stamp = "2026-10-07T10:00:00+00:00"
+    return runs.Run(negotiation, run, None, stamp, stamp, ending, {})
+
+
+def test_a_run_carried_into_the_planner_is_live_once_and_reads_waiting() -> None:
+    """The entrance's thread holds the run it carried, unanswered and not
+    waiting; the planner's, which moved after it, holds the proposal."""
+    found = runs.negotiations(
+        (),
+        (
+            live("chat:1/plan", "n1", "r1", "2026-10-07T10:01:00+00:00", waiting=True),
+            live("chat:1", "n1", "r1", "2026-10-07T10:00:00+00:00", waiting=False),
+        ),
+    )
+
+    assert [one.outcome for one in found] == [runs.WAITING]
+
