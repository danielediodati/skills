+# -- a plan answered in words (15c.1) ------------------------------------------
+
+THIRTY = "solo 30 minuti oggi"
+
+
+class Answering:
+    """A chat with an adaptation open: its graphs, the scripted entrance, the planner, and the archive."""
+
+    def __init__(
+        self, catalogued: sqlite3.Connection, tmp_path: Path, *offered: plans.WorkoutPlan
+    ) -> None:
+        served_from(catalogued)
+        self.archive = tmp_path / "runs"
+        self.saver = InMemorySaver()
+        self.planned = Scripted(documents=[adapted_of("Barbell_Squat", rounds=2, minutes=30), *offered])
+        self.front = Talking(turns=[calling(entrance.ADAPT_THIS_WORKOUT, said=THIRTY)])
+        self.graphs = graphs_of(
+            graph_of(self.planned, checkpointer=self.saver, archive=self.archive),
+            front=self.front,
+            saver=self.saver,
+            archive=self.archive,
+        )
+        ((_, self.buttons),) = asking(self.graphs, THIRTY).offers
+        self.first = self.pending()
+
+    def pending(self) -> str:
+        held = self.graphs.negotiation.pending(planning_on())
+        assert held is not None, "nothing is open"
+        return held.id
+
+    def writes(self, text: str, *turns: AIMessage) -> Channels:
+        """The user writes `text`, and the entrance takes `turns` on it."""
+        self.front.turns = list(turns)
+        return asking(self.graphs, text)
+
+    def ended(self) -> dict[str, str]:
+        """Every run of the planner the archive holds, by run, with its ending."""
+        return {
+            one["run"]: one["ending"]
+            for one in documents(self.archive)
+            if any(node["node"] == "propose" for node in one["nodes"]) or one["plan"] is not None
+        }
+
+    def outcomes(self) -> list[str]:
+        """How each negotiation reads to `trainer runs`, from the archive and the checkpointer."""
+        return [
+            one.outcome
+            for one in runs.negotiations(runs.kept(self.archive), runs.live(self.saver))
+        ]
+
