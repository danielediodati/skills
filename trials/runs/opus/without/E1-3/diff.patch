+def test_the_answer_to_that_question_reaches_the_handoff_with_the_ask(
+    connection: sqlite3.Connection,
+) -> None:
+    """Two turns on one thread: the second decides, and both stay in `said`
+    for the planner to read."""
+    model = Scripted(
+        turns=[
+            says("Solo per oggi o da ora in poi?"),
+            calling(entrance.CHANGE_MESOCYCLE),
+            says("Lo cambio."),
+        ]
+    )
+    graph = graph_of(model, checkpointer=InMemorySaver(), today=lambda: entrance.SERVING)
+    thread: RunnableConfig = {"configurable": {"thread_id": "one"}}
+
+    graph.invoke(entrance.heard("niente panca"), thread)
+    final = graph.invoke(entrance.heard("da ora in poi"), thread)
+
+    assert final["handoff"] == entrance.CHANGE_MESOCYCLE and final["carrying"]
+    assert final["said"][-2:] == ["niente panca", "da ora in poi"]
 
 
