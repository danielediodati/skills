+def keep(connection: sqlite3.Connection, *slots: plans.WorkoutPlan, cycles: int = 3) -> int:
+    """A mesocycle accepted, with these workouts for its slots."""
+    return mesocycles.record_mesocycle(
+        connection,
+        tuple(
+            tuple(
+                workouts.PrescribedBlock(block=costed, reason=shape.reason)
+                for shape, costed in zip(slot.blocks, plans.to_blocks(slot), strict=True)
+            )
+            for slot in slots
+        ),
+        cycles=cycles,
+        why="settle the loads",
+        on=TODAY,
+    )
