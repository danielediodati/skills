+def openrouter_models(key: str) -> set[str]:
+    """Every model OpenRouter routes for this key, as it names them; the seam the suite stands in for."""
+    import httpx
+
+    response = httpx.get(
+        OPENROUTER_MODELS_URL,
+        headers={"Authorization": f"Bearer {key}"},
+        timeout=30,
+    )
+    response.raise_for_status()
+    return {model["id"] for model in response.json()["data"]}
+
+
+def _openrouter_ready(on: Chat) -> None:
+    """The model OpenRouter routes under that name, or the state that says it does not."""
+    key = os.environ.get(OPENROUTER_KEY_ENV)
+    if not key:
+        raise ModelError(NO_OPENROUTER_CREDENTIALS)
+    try:
+        served = openrouter_models(key)
+    except Exception as error:
+        raise ModelError(f"OpenRouter cannot be reached ({error})") from error
+    if on.name not in served:
+        # Hundreds of names, so the fix points at the catalog instead of listing it.
+        raise ModelError(
+            f"OpenRouter does not route {on.name}; set "
+            f"{on.setting or OPENROUTER_MODEL_ENV} to {DEFAULT_OPENROUTER_MODEL}, "
+            "or leave it empty for the same, or pick another from "
+            "https://openrouter.ai/models"
+        )
