+def in_words(
+    catalogued: sqlite3.Connection,
+    archive: Path,
+    *planned: BaseModel,
+    log: coach_logger.Logger | None = None,
+) -> tuple[bot.Graphs, Talking, Channels, InMemorySaver]:
+    """Today's workout served, then adapted and offered; the entrance scripted turn by turn after that."""
+    served_from(catalogued)
+    mesocycles.record_served(catalogued, date.today().isoformat())
+    held = InMemorySaver()
+    front = Talking(turns=[calling(entrance.ADAPT_THIS_WORKOUT, said="oggi solo 30 minuti")])
+    graphs = graphs_of(
+        graph_of(Scripted(documents=list(planned)), checkpointer=held, archive=archive),
+        front=front,
+        log=log,
+        saver=held,
+        archive=archive,
+    )
+    first = asking(graphs, "oggi solo 30 minuti")
+    assert len(first.offers) == 1
+    return graphs, front, first, held
+
+
+def endings(archive: Path) -> list[str]:
+    return sorted(one["ending"] for one in documents(archive))
+
+
+def nothing_cut(archive: Path, held: InMemorySaver) -> None:
+    from trainer.coach import runs
+
+    for one in runs.negotiations(runs.kept(archive), runs.live(held)):
+        assert one.outcome != runs.CUT, runs.line(one)
+
+
