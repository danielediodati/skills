+def proposing(plans_on: planner.Planner) -> Callable[[str], entrance.Open | None]:
+    """The plan waiting on its answer on a chat thread, as the entrance is told it."""
+    talks = negotiations.Negotiation(plans_on)
+
+    def waiting(thread: str) -> entrance.Open | None:
+        held = talks.pending(_reading(under(thread, PLANNING)))
+        if held is None:
+            return None
+        return entrance.Open(held.id, _described(held))
+
+    return waiting
