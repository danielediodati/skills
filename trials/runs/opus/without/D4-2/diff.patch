+    graphs, front, _, held = in_words(
+        catalogued, archive, adapted_of("Barbell_Squat", rounds=2, minutes=30)
+    )
+    front.turns = [calling(entrance.ACCEPT_THE_PLAN)]
+
+    watched = asking(graphs, "ok")
+
+    assert watched.said == [SAYS, entrance.PRESCRIBED]
+    assert workout_states(catalogued) == ["prescribed"]
+    front.handoff = entrance.TODAYS_WORKOUT
+    (served,) = asking(graphs, "cosa faccio oggi?").offers
+    assert "*Blocco 1* · 2 giri" in served[0], "the adapted workout is today's"
+    # The adaptation, the «ok» turn, and saying it was prescribed.
+    assert endings(archive)[:3] == [run_record.ACCEPTED, run_record.DONE, run_record.DONE]
+    nothing_cut(archive, held)
+
