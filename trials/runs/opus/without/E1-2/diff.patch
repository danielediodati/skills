+    _, served = mesocycles.record_served(connection, date.today().isoformat())
+    (block,) = workouts.prescribed(connection, served)
+    workouts.record_performed(
+        connection,
+        (
+            workouts.PerformedBlock(
+                items=tuple(
+                    workouts.PerformedItem(
+                        exercise_id=item.exercise_id,
+                        unit="reps",
+                        amount=item.reps or 1,
+                        amount_source="reported",
+                    )
+                    for item in block.block.items
+                ),
+                rounds=block.block.rounds,
+                rounds_source="reported",
+                rest=block.block.rest,
+                rest_source="reported",
+            ),
+        ),
+        on=date.today().isoformat(),
+        report="fatto",
+        workout_id=served,
+    )
+
