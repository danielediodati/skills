+def test_an_adaptation_whose_day_was_reported_ends_stopped_on_the_real_checkpointer(
+    catalogued: sqlite3.Connection, declared: Path, tmp_path: Path
+) -> None:
+    """Cleared from the checkpointer the bot uses, so nothing can answer it after."""
+    last = on_its_last_workout(catalogued)
+    asked = entrance.requested(catalogued, entrance.ADAPT_THIS_WORKOUT, {"said": "solo 30 minuti oggi"})
+    archive = tmp_path / "runs"
+    with checkpoints.saver(tmp_path / "checkpoints.sqlite") as saver:
+        talks = negotiations.Negotiation(
+            graph_of(
+                Scripted(documents=[adapted_of("Barbell_Squat", counts_as=2, rounds=2, minutes=30)]),
+                checkpointer=saver,
+                archive=archive,
+            ),
+            archive=archive,
+        )
+        offered = talks.open(PLANNING, asked)
+        assert isinstance(offered, negotiations.Proposed), offered
+        assert not talks.outlived(PLANNING), "nothing reported yet"
+
+        performed_once(catalogued, "Standing_Military_Press", last)
+
+        assert talks.outlived(PLANNING)
+        assert talks.pending(PLANNING) is None
+        assert talks.answer(PLANNING, offered.id, planner.accepted()) == negotiations.Superseded()
+    (written,) = [run.ending for run in runs.kept(archive)]
