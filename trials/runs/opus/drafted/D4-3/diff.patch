+def adapting(catalogued: sqlite3.Connection, tmp_path: Path) -> tuple[negotiations.Negotiation, int]:
+    """Today's workout served off a kept mesocycle, and an adaptation of it waiting."""
+    served_from(catalogued)
+    _, served = mesocycles.record_served(catalogued, date.today().isoformat())
+    with tools.opened() as connection:
+        asked = plans.adaptation_requested(connection, date.today().isoformat(), said="solo oggi")
+    talks = negotiation_of(Scripted(documents=[adapted_of("Barbell_Squat", rounds=2)]), tmp_path)
+    assert isinstance(talks.open(PLANNING, asked), negotiations.Proposed)
+    return talks, served
+
