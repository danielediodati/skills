+NEEDED = ("tools", "structured_outputs")
+"""What every graph asks of a model: tool calls on each turn, strict `json_schema` on emit."""
+
+
+def openrouter_models(key: str) -> dict[str, frozenset[str]]:
+    """Every model OpenRouter serves, with the parameters it supports, after the key is checked."""
+    import httpx
+
+    headers = {"Authorization": f"Bearer {key}"}
+    # The model list answers without a key, so the key is asked about on its own.
+    httpx.get(f"{OPENROUTER_URL}/key", headers=headers).raise_for_status()
+    listed = httpx.get(f"{OPENROUTER_URL}/models", headers=headers)
+    listed.raise_for_status()
+    return {
+        model["id"]: frozenset(model.get("supported_parameters") or ())
+        for model in listed.json()["data"]
+    }
+
+
+def _openrouter_ready(on: Chat) -> None:
+    """The model OpenRouter serves under that name with what the graphs need, or the state that says not."""
+    key = os.environ.get(OPENROUTER_KEY_ENV)
+    if not key:
+        raise ModelError(NO_OPENROUTER_CREDENTIALS)
+    try:
+        served = openrouter_models(key)
+    except Exception as error:
+        raise ModelError(f"OpenRouter cannot be reached ({error})") from error
+    setting = on.setting or OPENROUTER_MODEL_ENV
+    # A `:nitro` or `:floor` suffix picks a routing, not another model.
+    supports = served.get(on.name, served.get(on.name.split(":")[0]))
+    if supports is None:
+        # The list is hundreds long, so the fix names the default instead.
+        raise ModelError(
+            f"OpenRouter does not serve {on.name}; set {setting} to "
+            f"{DEFAULT_OPENROUTER_MODEL}, or leave it empty for the same"
+        )
+    missing = [needed for needed in NEEDED if needed not in supports]
+    if missing:
+        raise ModelError(
+            f"{on.name} on OpenRouter has no {' or '.join(missing)}, which every "
+            f"graph needs; set {setting} to a model that has both, such as "
+            f"{DEFAULT_OPENROUTER_MODEL}"
+        )
+
