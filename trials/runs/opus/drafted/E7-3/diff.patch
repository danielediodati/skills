+ROUTED_ONLY_WHERE_HONOURED = {"provider": {"require_parameters": True}}
+"""Route a request only to a provider that supports every parameter it carries.
+
+OpenRouter's default ignores a parameter the chosen provider lacks, so a
+strict `response_format` could be dropped on the way and the enum of
+admissible ids would stop holding by construction.
+"""
+
+
+class ChatOpenRouter(BaseChatOpenAI):
+    """The OpenAI-compatible chat model on OpenRouter, asking for strict structured output unless told otherwise."""
+
+    def with_structured_output(
+        self, schema: Any = None, *, strict: bool | None = None, **kwargs: Any
+    ) -> Runnable[Any, Any]:
+        # The OpenAI integration sends `strict: false` for a dict schema when
+        # `strict` is not passed. Groq's does not, and the graphs call this
+        # the same way on every provider.
+        if kwargs.get("method") == "json_schema" and strict is None:
+            strict = True
+        return super().with_structured_output(schema, strict=strict, **kwargs)
+
+
+def openrouter_model(named: str | None = None) -> ChatOpenRouter:
+    """The OpenRouter chat model the environment names, or another OpenRouter serves."""
+    key = os.environ.get(OPENROUTER_KEY_ENV)
+    if not key:
+        raise ModelError(NO_OPENROUTER_CREDENTIALS)
+    return ChatOpenRouter(
+        model=named or openrouter_model_name(),
+        api_key=SecretStr(key),
+        base_url=OPENROUTER_URL,
+        max_tokens=openrouter_max_tokens(),
+        extra_body=ROUTED_ONLY_WHERE_HONOURED,
+    )
+
