+) -> None:
+    """Three performed in a two-slot cycle: the change lands in cycle 2, and
+    the cycles it is given count from there."""
+    first = accepted(connection, cycles=4)
+    for _ in range(3):
+        _, served = mesocycles.record_served(connection, TODAY)
+        performed(connection, served)
+
+    changed = mesocycles.record_mesocycle(
+        connection,
+        (slot("Plank"), slot("Plank", reps=None, seconds=45)),
+        cycles=2,
+        why="no more squats",
+        on=TODAY,
+        changing=first,
+    )
+
+    found = mesocycles.today(connection)
+    assert found.mesocycle == changed != first
+    assert (found.slot, found.cycle, found.cycles) == (2, 2, 3)
+    assert found.blocks == slot("Plank", reps=None, seconds=45)
+
