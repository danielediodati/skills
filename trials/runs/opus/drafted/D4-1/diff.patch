+def adaptation_pending(
+    catalogued: sqlite3.Connection, tmp_path: Path
+) -> tuple[negotiations.Negotiation, negotiations.Proposed]:
+    """A kept mesocycle, and an adaptation of today's workout offered on it."""
+    served_from(catalogued)
+    talks = negotiation_of(Scripted(documents=[adapted_of("Barbell_Squat", rounds=2)]), tmp_path)
+    with tools.opened() as connection:
+        asked = plans.adaptation_requested(connection, date.today().isoformat(), said="oggi poco")
+    offered = talks.open(PLANNING, asked)
+    assert isinstance(offered, negotiations.Proposed)
+    return talks, offered
+
+
+def test_an_adaptation_ends_once_the_workout_it_adapts_is_performed(
+    catalogued: sqlite3.Connection, declared: Path, tmp_path: Path
+) -> None:
+    talks, offered = adaptation_pending(catalogued, tmp_path)
+    _, served = mesocycles.record_served(catalogued, date.today().isoformat())
+    performed_once(catalogued, "Barbell_Squat", served)
+
+    ended = talks.overtaken(PLANNING)
+
+    assert ended is not None and ended["ending"] == "superseded"
+    assert talks.pending(PLANNING) is None
+    assert talks.answer(PLANNING, offered.id, planner.accepted()) == negotiations.Superseded()
+    assert [state for _, state in workout_rows(catalogued)] == ["performed"]
+
+
