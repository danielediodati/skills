+    def end(self, on: RunnableConfig) -> dict[str, Any] | None:
+        """The proposal pending on this thread ended unanswered, as superseded; its record, or nothing when none was."""
+        if self.pending(on) is None:
+            return None
+        held = self._planner.get_state(on).values
+        finished = records.closing(held, records.SUPERSEDED, self._budget, self._archive)
+        # Written as the node that ends the graph, so the thread is left with
+        # no interrupt to resume and a tap on the old buttons finds nothing.
+        self._planner.update_state(on, finished, as_node="prescribe")
+        return records.of({**held, **finished}, self._budget)
+
+    def overtaken(self, on: RunnableConfig) -> dict[str, Any] | None:
+        """The adaptation pending on this thread ended once the workout it adapts is performed; its record, or nothing."""
