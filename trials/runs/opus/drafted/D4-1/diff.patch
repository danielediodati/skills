+def test_a_new_ask_over_a_pending_proposal_ends_it_as_superseded(
+    catalogued: sqlite3.Connection, tmp_path: Path
+) -> None:
+    talks = negotiation_of(
+        Scripted(documents=[plan_of("Barbell_Squat"), plan_of("Barbell_Squat")]), tmp_path
+    )
+    old = talks.open(PLANNING, BARBELL_45)
+    assert isinstance(old, negotiations.Proposed)
+
+    talks.open(PLANNING, BARBELL_45)
+
+    endings = [
+        json.loads(written.read_text(encoding="utf-8"))["ending"]
+        for written in (tmp_path / "runs").glob("*/*.json")
+    ]
+    assert endings == ["superseded"]
+
