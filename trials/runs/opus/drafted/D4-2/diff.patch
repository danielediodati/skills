+    assert [one.outcome for one in runs.negotiations(closed, ())] == ["accepted"]
+
+
+def test_a_proposal_the_machine_replaces_ends_too_and_starts_its_own_negotiation(
+    catalogued: sqlite3.Connection, tmp_path: Path
+) -> None:
+    talks = negotiation_of(
+        Scripted(documents=[plan_of("Barbell_Squat"), plan_of("Barbell_Squat")]), tmp_path
+    )
+    talks.open(PLANNING, BARBELL_45)
+    first = talks.continuing(PLANNING)
+
+    talks.open(PLANNING, BARBELL_45, unasked=True)
+
+    assert talks.continuing(PLANNING)["negotiation"] != first["negotiation"]
+    (closed,) = runs.kept(tmp_path / "runs")
+    assert (closed.run, closed.ending) == (first["follows"], "stopped")
+
+
+def adapting(
+    catalogued: sqlite3.Connection, tmp_path: Path
+) -> tuple[negotiations.Negotiation, negotiations.Proposed]:
+    """A kept mesocycle and an adaptation of today's workout, offered and waiting."""
+    served_from(catalogued)
+    with tools.opened() as connection:
+        request = plans.adaptation_requested(
+            connection, date.today().isoformat(), said="solo 30 minuti"
+        )
+    talks = negotiation_of(
+        Scripted(documents=[adapted_of("Barbell_Squat", rounds=2, minutes=30)]), tmp_path
+    )
+    offered = talks.open(PLANNING, request)
+    assert isinstance(offered, negotiations.Proposed)
+    return talks, offered
+
+
+def reported_today(catalogued: sqlite3.Connection) -> None:
+    _, served = mesocycles.record_served(catalogued, date.today().isoformat())
+    performed_once(catalogued, "Barbell_Squat", served)
+
+
+def test_an_adaptation_ends_once_the_workout_it_adapts_is_reported(
+    catalogued: sqlite3.Connection, declared: Path, tmp_path: Path
+) -> None:
+    talks, _ = adapting(catalogued, tmp_path)
+    assert not talks.lapsed(PLANNING), "nothing reported yet"
+
+    reported_today(catalogued)
+
+    assert talks.lapsed(PLANNING)
+    assert talks.pending(PLANNING) is None
+    assert not talks.lapsed(PLANNING), "ended once"
+    (closed,) = runs.kept(tmp_path / "runs")
+    assert closed.ending == "stopped"
+
+
+def test_a_tap_on_an_adaptation_whose_workout_was_reported_changes_nothing(
+    catalogued: sqlite3.Connection, declared: Path, tmp_path: Path
+) -> None:
+    """Reported where the negotiation was never told, as `trainer log` does."""
+    talks, offered = adapting(catalogued, tmp_path)
+    reported_today(catalogued)
+    before = workout_rows(catalogued)
+
+    answered = talks.answer(PLANNING, offered.id, planner.accepted())
+
+    assert answered == negotiations.Superseded()
+    assert workout_rows(catalogued) == before
+    (closed,) = runs.kept(tmp_path / "runs")
+    assert closed.ending == "stopped"
