+async def _negotiating(
+    graphs: Graphs, thread: str, text: str, final: Mapping[str, Any], chat: Chat
+) -> None:
+    """The planner, asked for an adaptation or a change in the user's own words.
+
+    With no mesocycle serving today the entrance has already said so, and
+    there is nothing to start.
+    """
+    changing = final.get("handoff") == entrance.CHANGE_MESOCYCLE
+    try:
+        request = await asyncio.to_thread(_negotiated, changing, text)
+    except tools.ToolFailure as state:
+        logger.warning("%s cannot plan: %s", thread, state, exc_info=True)
+        await chat.say(BLOCKED)
+        return
+    if request is None or not final.get("carrying"):
+        logger.info("%s has no mesocycle to adapt or change", thread)
+        return
+    given = dict(planner.starting(request)) | entrance.carried(final)
+    await _proposing(graphs, thread, given, chat)
+
