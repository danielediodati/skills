+    request = plans.adaptation_requested(connection, date.today().isoformat(), "solo 30 minuti")
+    graph, thread = pausing(Scripted(documents=[plan_of("Barbell_Squat", rounds=2)]))
+    graph.invoke(planner.starting(request), thread)
