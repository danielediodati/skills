+def test_a_change_carries_on_the_cycle_count(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    """Three performed on a two-slot cycle is cycle 2; two more cycles from it
+    is a mesocycle of three that started where the old one did."""
+    identifier = accepted(connection, cycles=4)
+    for _ in range(3):
+        _, served = mesocycles.record_served(connection, TODAY)
+        performed(connection, served)
+    old = mesocycles.active(connection)
+    assert old is not None
+
+    changed = mesocycles.record_change(
+        connection,
+        (slot("Plank", reps=None, seconds=60), slot("Plank", reps=None, seconds=45)),
+        replacing=identifier,
+        cycles=2,
+        why="no more squats",
+        on=TODAY,
+    )
+
+    kept = mesocycles.active(connection)
+    assert kept is not None and kept.id == changed != identifier
+    assert (kept.accepted_after, kept.cycles) == (old.accepted_after, 3)
+    found = mesocycles.today(connection)
+    assert (found.slot, found.cycle, found.cycles) == (2, 2, 3)
