+    changing: bool, said: str
+) -> plans.Request | plans.MesocycleRequest | None:
+    """A change's or an adaptation's request, or `None` when no mesocycle serves today."""
+    today = date.today().isoformat()
+    with tools.reported(), tools.opened() as connection:
