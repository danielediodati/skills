+def record_adapted(
+    connection: sqlite3.Connection,
+    blocks: Sequence[workouts.PrescribedBlock],
+    on: str,
+    *,
+    mesocycle: int,
+    slot: int,
+    served_after: int,
+) -> int:
+    """Prescribe an accepted adaptation as that slot's serving, replacing any serving before it, and return its id."""
+    if not blocks:
+        raise workouts.WorkoutError("a workout is at least one block")
+    duration.check_plan([prescribed.block for prescribed in blocks])
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        workout_id = workouts.write_prescribed(connection, blocks, on)
+        # Replaced rather than added beside: asked again, the slot serves this one.
+        connection.execute(
+            "INSERT INTO served (workout_id, mesocycle_id, slot, served_after) "
+            "VALUES (?, ?, ?, ?) "
+            "ON CONFLICT (mesocycle_id, served_after) DO UPDATE SET workout_id = excluded.workout_id",
+            (workout_id, mesocycle, slot, served_after),
+        )
+        connection.execute("COMMIT")
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except sqlite3.Error:
+            pass
+        raise
+    return workout_id
