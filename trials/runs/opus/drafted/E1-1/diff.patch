+def test_a_change_continues_the_cycle_count_of_the_one_it_replaces(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection, cycles=3)
+    for _ in range(2):
+        _, served = mesocycles.record_served(connection, TODAY)
+        performed(connection, served)
+    replaced = mesocycles.active(connection)
+    assert replaced is not None
+
+    mesocycles.record_mesocycle(
+        connection,
+        (slot("Plank", reps=None, seconds=30), slot("Barbell_Squat")),
+        cycles=3,
+        why="no more of the old one",
+        on=TODAY,
+        accepted_after=replaced.accepted_after,
+    )
+
+    found = mesocycles.today(connection)
+    assert (found.slot, found.cycle, found.cycles) == (1, 2, 3)
+    assert found.blocks == slot("Plank", reps=None, seconds=30)
+
+
+def test_an_adaptation_is_the_slots_serving_and_leaves_the_mesocycle_alone(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection)
+    before = mesocycles.active(connection)
+    assert before is not None
+
+    adapted = mesocycles.record_adapted(
+        connection, slot("Plank"), TODAY, mesocycle=before.id, slot=1, served_after=0
+    )
+
+    _, served = mesocycles.record_served(connection, TODAY)
+    assert served == adapted
+    assert workouts.prescribed(connection, served) == slot("Plank")
+    assert mesocycles.active(connection) == before
+
+
+def test_an_adaptation_after_serving_replaces_the_serving(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    """Asked again, the slot is the adapted workout, not the unadapted one beside it."""
+    identifier = accepted(connection)
+    _, first = mesocycles.record_served(connection, TODAY)
+
+    adapted = mesocycles.record_adapted(
+        connection, slot("Plank"), TODAY, mesocycle=identifier, slot=1, served_after=0
+    )
+
+    _, again = mesocycles.record_served(connection, TODAY)
+    assert again == adapted != first
+    assert workouts.awaiting(connection) == workouts.workout(connection, adapted)
+
+
