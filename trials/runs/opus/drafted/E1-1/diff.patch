+def change_requested(
+    connection: sqlite3.Connection, today: str, wanted: Sequence[str]
+) -> MesocycleRequest:
+    """A mesocycle's request rewriting the active one as `wanted` says, or a new one when none is active."""
+    asked = mesocycle_requested(connection, today)
+    kept = mesocycles.active(connection)
+    if kept is None:
+        return asked
+    since = state.rotation(connection).performed - kept.accepted_after
+    return dataclasses.replace(
+        asked,
+        change=Change(
+            wanted=tuple(wanted),
+            current=Mesocycle(
+                workouts=[from_prescribed(blocks) for blocks in kept.slots],
+                cycles=kept.cycles,
+                why=kept.why,
+            ),
+            done=since // len(kept.slots),
+            accepted_after=kept.accepted_after,
+        ),
+    )
+
+
+def adaptation(connection: sqlite3.Connection) -> Adapting | None:
+    """Today's slot of the active mesocycle as an adaptation's starting point, or `None` when none serves one."""
+    try:
+        found = mesocycles.today(connection)
+    except mesocycles.MesocycleError:
+        return None
+    return Adapting(
+        mesocycle=found.mesocycle,
+        slot=found.slot,
+        served_after=state.rotation(connection).performed,
+        workout=from_prescribed(found.blocks),
