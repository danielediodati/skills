     assert f"  kept mesocycle {final['mesocycle']}" in record.summary(written)
 
 
+# -- a change and an adaptation (ADR-0008 item 6) ------------------------------
+
+
+def kept_mesocycle(connection: sqlite3.Connection, cycles: int = 3) -> int:
+    """A mesocycle accepted before this test, written straight to the engine."""
+    return mesocycles.record_mesocycle(
+        connection,
+        tuple(
+            tuple(
+                workouts.PrescribedBlock(block=costed, reason=shape.reason)
+                for shape, costed in zip(workout.blocks, plans.to_blocks(workout), strict=True)
+            )
+            for workout in (plan_of("Barbell_Squat"), plan_of("Standing_Military_Press"))
+        ),
+        cycles=cycles,
+        why="settle the loads",
+        on="2026-09-01",
+    )
+
+
+def performed_once(connection: sqlite3.Connection) -> None:
+    workouts.record_performed(
+        connection,
+        (
+            workouts.PerformedBlock(
+                items=(
+                    workouts.PerformedItem(
+                        exercise_id="Barbell_Squat", unit="reps", amount=5, amount_source="reported"
+                    ),
+                ),
+                rounds=3,
+                rounds_source="reported",
+                rest=120,
+                rest_source="reported",
+            ),
+        ),
+        on="2026-09-02",
+        report="squats",
+    )
+
+
+def adapted_request(connection: sqlite3.Connection, minutes: int) -> plans.Request:
+    asked = plans.requested(connection, "2026-09-22", plans.Asked(minutes=minutes)).request
+    return dc_replace(asked, adapting=plans.adaptation(connection))
+
+
+def test_an_adaptation_is_briefed_with_todays_slot_as_its_starting_point(
+    connection: sqlite3.Connection, two_slots: plans.MesocycleRequest
+) -> None:
+    kept_mesocycle(connection)
+    model = Scripted(documents=[plan_of("Barbell_Squat", rounds=2)])
+
+    graph_of(model).invoke({"request": adapted_request(connection, 30)})
+
+    briefed = "\n".join(message.text for message in model.seen[0])
+    assert "Time available: 30 minutes." in briefed
+    assert "workout 1 of their mesocycle" in briefed
+    assert '"exercise_id": "Barbell_Squat"' in briefed
+
+
+def test_an_accepted_adaptation_is_todays_serving_and_the_mesocycle_is_unchanged(
+    connection: sqlite3.Connection, two_slots: plans.MesocycleRequest
+) -> None:
+    kept_mesocycle(connection)
+    before = mesocycles.active(connection)
+    graph, thread = pausing(Scripted(documents=[plan_of("Barbell_Squat", rounds=2)]))
+    graph.invoke(planner.starting(adapted_request(connection, 30)), thread)
+
+    final = graph.invoke(Command(resume=planner.accepted()), thread)
+
+    assert mesocycles.active(connection) == before
+    _, served = mesocycles.record_served(connection, "2026-09-22")
+    assert served == final["workout"]
+    assert workouts.prescribed(connection, served)[0].block.rounds == 2
+
+
+def test_a_change_is_briefed_with_the_mesocycle_and_the_words_as_typed(
+    connection: sqlite3.Connection, two_slots: plans.MesocycleRequest
+) -> None:
+    kept_mesocycle(connection)
+    for _ in range(2):
+        performed_once(connection)
+    changed = mesocycle_of(plan_of("Barbell_Squat", rounds=2), plan_of("Standing_Military_Press"))
+    model = Scripted(raw=[changed.model_dump_json()])
+
+    graph_of(model).invoke(
+        planner.starting(plans.change_requested(connection, "2026-09-22", ("meno giri di squat",)))
+    )
+
+    briefed = "\n".join(message.text for message in model.seen[0])
+    assert "- meno giri di squat" in briefed
+    assert "completed 1 of its 3 cycles" in briefed
+    assert '"exercise_id": "Standing_Military_Press"' in briefed
+
+
+def test_an_accepted_change_replaces_the_mesocycle_and_continues_its_count(
+    connection: sqlite3.Connection, two_slots: plans.MesocycleRequest
+) -> None:
+    replaced = kept_mesocycle(connection)
+    for _ in range(2):
+        performed_once(connection)
+    changed = mesocycle_of(
+        plan_of("Barbell_Squat", rounds=2), plan_of("Standing_Military_Press"), cycles=2
+    )
+    graph, thread = pausing(Scripted(raw=[changed.model_dump_json()]))
+    graph.invoke(
+        planner.starting(plans.change_requested(connection, "2026-09-22", ("meno giri",))),
+        thread,
+    )
+
+    final = graph.invoke(Command(resume=planner.accepted()), thread)
+
+    kept = mesocycles.active(connection)
+    assert kept is not None and kept.id == final["mesocycle"] != replaced
+    found = mesocycles.today(connection)
+    assert (found.cycle, found.cycles) == (2, 3), "one done, two more from now"
+    assert found.blocks[0].block.rounds == 2
+
+
+def test_a_change_with_no_mesocycle_running_is_a_new_one(
