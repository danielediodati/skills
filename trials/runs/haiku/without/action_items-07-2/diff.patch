 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, by_name: dict, notes_key: str) -> Optional[str]:
+    if _key(text) in _EMPTY:
+        return None
+    if _key(text) in by_name:
+        return by_name[_key(text)]
+    # Not in the meeting: keep the name only if the notes name this person as
+    # a whole word, so an owner the model made up does not reach the list.
+    name = " ".join(text.split())
+    if re.search(rf"(?<!\w){re.escape(_key(name))}(?!\w)", notes_key):
+        return name
+    return None
 
 
