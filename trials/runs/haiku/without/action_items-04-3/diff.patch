 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _find_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """Return the one attendee that `text` names, or None if it names none or several.
+
+    Accepts the full name, a first name or nickname ("Tom" or "Tommy" for
+    "Tom Becker"), a surname, or a first name with an initial ("Ana R.").
+    """
+    wanted = _key(text).split()
+    if not wanted:
+        return None
+    full = [name for name in attendees if _key(name) == _key(text)]
+    if full:
+        return full[0]
+    matches = [name for name in attendees if _names(wanted, name)]
+    return matches[0] if len(matches) == 1 else None
+
+
+def _names(words: List[str], attendee: str) -> bool:
+    parts = _key(attendee).split()
+    first, last = parts[0], parts[-1]
+    if len(words) == 1:
+        return _is_nickname(words[0], first) or words[0] == last
+    if len(words) == 2:
+        return _is_nickname(words[0], first) and _is_initial(words[1], last)
+    return False
+
+
+def _is_nickname(word: str, first: str) -> bool:
+    word = word.rstrip(".")
+    shorter, longer = sorted((word, first), key=len)
+    return len(shorter) >= _NICKNAME_MIN and longer.startswith(shorter)
+
+
+def _is_initial(word: str, last: str) -> bool:
+    return word.rstrip(".") == last[:1]
 
 
