 import re
 
 MAX_REASON_CHARS = 80
+ASKED_REASON_CHARS = 70
 
 PROMPT = """A customer of an online shop searched for: {query}
 
 Pick up to {limit} products from the list that best match the search, best first.
-Answer with one product per line, as: ID | one short reason, addressed to the customer
+Answer with one product per line, as: ID | one complete sentence of at most {reason_chars} characters, addressed to the customer
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+SENTENCE_END = re.compile(r"[.!?]+(?=\s|$)")
+
+
+def _complete_reason(text):
+    """Return `text` if it fits, else its longest run of whole sentences that fits, else ""."""
+    text = " ".join(text.split())
+    if len(text) <= MAX_REASON_CHARS:
+        return text
+    ends = [m.end() for m in SENTENCE_END.finditer(text) if m.end() <= MAX_REASON_CHARS]
+    return text[:ends[-1]] if ends else ""
 
 
 def recommend_products(query, catalog, model, limit=5):
