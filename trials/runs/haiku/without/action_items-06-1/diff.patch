+def _resolve_phrase(phrase: str, meeting_date: date) -> Optional[date]:
+    """Turn "Friday", "next Monday" or "end of next week" into a date.
+
+    A bare weekday means the next such day, counting the meeting day itself.
+    Anything else returns None rather than a guess.
+    """
+    monday = meeting_date - timedelta(days=meeting_date.weekday())
+    match = _WEEKDAY.match(phrase)
+    if match:
+        day = WEEKDAYS.index(match.group(2))
+        if match.group(1):  # "next Friday" is the Friday of the following week
+            return monday + timedelta(days=7 + day)
+        return meeting_date + timedelta(days=(day - meeting_date.weekday()) % 7)
+    match = _END_OF_WEEK.match(phrase)
+    if match:
+        weeks = 1 if match.group(1) == "next" else 0
+        return monday + timedelta(days=7 * weeks + 4)  # the Friday
+    return None
