+def _plain_decimal(text, label):
+    """Turn a printed amount such as '1.250,00 EUR' into '1250.00'.
+
+    Dots and commas are read by position: the last one is the decimal mark and
+    the others group thousands. A lone separator followed by exactly three digits
+    ('1.250') could be either 1.25 or 1250, so it is refused rather than guessed.
+    """
+    s = re.sub(r"EUR|GBP|USD|CHF|€|£|\$", "", text.strip(), flags=re.IGNORECASE)
+    s = re.sub(r"[\s'  ]", "", s)
+    m = re.fullmatch(r"(-?)(\d+(?:[.,]\d+)*)", s)
+    if not m:
+        return text
+    sign, body = m.groups()
+    seps = [c for c in body if c in ".,"]
+    if not seps:
+        return sign + body
+    decimal = seps[-1]
+    if len(set(seps)) == 2:
+        if seps.count(decimal) != 1:
+            return text
+        thousands = "." if decimal == "," else ","
+        int_part, frac = body.split(decimal)
+        groups = int_part.split(thousands)
+        if not all(len(g) == 3 for g in groups[1:]):
+            return text
+        return sign + "".join(groups) + "." + frac
+    parts = body.split(decimal)
+    if len(parts) > 2:
+        if not all(len(g) == 3 for g in parts[1:]):
+            return text
+        return sign + "".join(parts)
+    int_part, frac = parts
+    if len(frac) == 3 and int_part != "0":
+        raise InvoiceError(f"{label} could be read two ways: {text!r}")
+    return sign + int_part + "." + frac
+
