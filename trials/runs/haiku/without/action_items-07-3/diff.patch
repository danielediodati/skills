+def _parse_owner(text: str, by_name: dict) -> Tuple[Optional[str], bool]:
+    """Return (owner, present). Attendees get their spelling from the caller;
+    anyone else keeps the name as the model wrote it, marked not present."""
+    name = " ".join(text.split())
+    if _key(name) in _EMPTY:
+        return None, True
+    if _key(name) in by_name:
+        return by_name[_key(name)], True
+    return name, False
+
+
