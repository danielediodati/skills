+def _decimal(text):
+    # Suppliers print amounts their own way: "1.250,00" (Germany, Italy),
+    # "1 250,00" (France), "1,250.00" (Britain). The last separator is the
+    # decimal point, unless the separators are the same and repeated ("1.250.000")
+    # or a lone separator is followed by three digits ("1.250"), which makes it
+    # a thousands separator. "0.335" stays a decimal because the integer part is 0.
+    cleaned = re.sub(r"[\s'  ]", "", text)
+    match = re.fullmatch(r"[^\d+-]*([-+]?\d[\d.,]*)\D*", cleaned)
+    if not match:
+        raise InvalidOperation(text)
+    sign = "-" if match.group(1).startswith("-") else ""
+    body = match.group(1).lstrip("+-")
+
+    dots, commas = body.count("."), body.count(",")
+    last = max(body.rfind("."), body.rfind(","))
+    decimal = None
+    if dots and commas:
+        decimal = body[last]
+    elif dots + commas == 1 and not (len(body) - last - 1 == 3 and body[:last] != "0"):
+        decimal = body[last]
+
+    if decimal:
+        integer, fraction = body.rsplit(decimal, 1)
+    else:
+        integer, fraction = body, ""
+    integer = re.sub(r"[.,]", "", integer)
+    return Decimal(f"{sign}{integer}.{fraction}" if fraction else f"{sign}{integer}")
+
+
 def _cents(amount):
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
