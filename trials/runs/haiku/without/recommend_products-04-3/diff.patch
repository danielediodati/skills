 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+The reason must not mention any price, rating, or how a product ranks or compares with the others.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# Words or figures that claim a price, a rating or a standing against other products.
+# The shop shows those itself, so a reason containing one is dropped rather than shown.
+CLAIM = re.compile(
+    r"\d|[$£€]|\b(?:under|below|over|above|most|least|first|leading|"
+    r"cheap\w*|budget|afford\w*|bargain|deal\w*|pric\w*|cost\w*|value\w*|"
+    r"rat(?:e|ed|es|ing|ings)|stars?|reviews?|top\w*|best\w*|highest|lowest|"
+    r"better|worst|popular|favou?rite\w*)\b",
+    re.IGNORECASE,
+)
 
 
 def recommend_products(query, catalog, model, limit=5):
