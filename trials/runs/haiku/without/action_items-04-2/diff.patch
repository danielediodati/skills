 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _name_key(text: str) -> str:
+    return _key(text.replace(".", " "))
+
+
+def _resolve_owner(
+    text: str,
+    attendees: Sequence[str],
+    aliases: Mapping[str, Sequence[str]],
+) -> Optional[str]:
+    """The one attendee that `text` names, or None if it names none or several.
+
+    Full names are tried first, then nicknames, then every word of `text` must
+    be a word of the attendee's name, with a single letter standing for the
+    start of a word. Anything less certain is left unassigned.
+    """
+    words = _name_key(text).split()
+    if not words or " ".join(words) in _EMPTY:
+        return None
+    wanted = " ".join(words)
+
+    matches = [name for name in attendees if _name_key(name) == wanted]
+    if not matches:
+        matches = [
+            name
+            for name in attendees
+            if wanted in {_name_key(nick) for nick in aliases.get(name, ())}
+        ]
+    if not matches:
+        matches = [name for name in attendees if _has_words(words, name)]
+
+    found = set(matches)
+    return found.pop() if len(found) == 1 else None
+
+
+def _has_words(words: List[str], name: str) -> bool:
+    parts = _name_key(name).split()
+    return all(
+        any(part == word or (len(word) == 1 and part.startswith(word)) for part in parts)
+        for word in words
+    )
 
 
