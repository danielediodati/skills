+    def test_single_charge_without_quantity_is_one_unit(self):
+        # NF-0718: a delivery charge is printed as one amount, with no quantity.
+        lines = [
+            {"description": "Steel brackets", "quantity": 40, "unit_price": 6.25},
+            {"description": "Delivery", "unit_price": 35.00},
+        ]
+        result = extract(lines=lines, total=285.00)
+        self.assertEqual(result["lines"][1]["quantity"], Decimal("1"))
+        self.assertEqual(result["lines"][1]["amount"], Decimal("35.00"))
+        self.assertEqual(result["lines_total"], Decimal("285.00"))
+        self.assertEqual(result["status"], "ok")
+
+    def test_missing_quantity_on_a_multi_unit_line_is_a_mismatch(self):
+        # Read as one unit, 40 brackets at 6.25 come to 6.25, which no longer matches the total.
+        lines = [{"description": "Steel brackets", "unit_price": 6.25}]
+        result = extract(lines=lines, total=250.00)
+        self.assertEqual(result["status"], "mismatch")
+
+    def test_missing_unit_price_is_still_an_error(self):
