+def _strip_quotes(body):
+    """Drop the earlier messages that mail clients quote in a reply.
+
+    If nothing is left once they are removed, the whole body is kept.
+    """
+    lines = body.splitlines()
+    kept = []
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        if ORIGINAL_MESSAGE.match(line) or _starts_forwarded_header(lines, i):
+            break
+        if QUOTED_LINE.match(line) or ATTRIBUTION.match(line):
+            i += 1
+        elif (ATTRIBUTION_START.match(line) and i + 1 < len(lines)
+              and WROTE_END.search(lines[i + 1])):
+            # Attribution line wrapped onto two lines.
+            i += 2
+        else:
+            kept.append(line)
+            i += 1
+    return "\n".join(kept).strip() or body
+
+
+def _starts_forwarded_header(lines, i):
+    """True at an Outlook-style "From:" line followed by "Sent:" or "Date:"."""
+    return bool(FROM_LINE.match(lines[i])) and any(
+        SENT_LINE.match(line) for line in lines[i + 1:i + 4]
+    )
+
+
+def _fit(text):
+    """Keep the start and the end of a long body, since requests often come last."""
+    if len(text) <= MAX_BODY_CHARS:
+        return text
+    half = MAX_BODY_CHARS // 2
+    return "{}\n[...]\n{}".format(text[:half], text[-half:])
+
+
