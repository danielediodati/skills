@@ -8,12 +8,24 @@
 
 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+The reason says how the product suits the search. It must not mention any price, rating,
+number, discount, or how the product ranks or compares on price or rating.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+# A reason that states a figure or a price or rating claim can contradict the
+# price and rating shown beside it, so it is dropped rather than shown.
+PRICE_OR_RATING_CLAIM = re.compile(
+    r"\d|[£€$¥]"
+    r"|\b(?:price|prices|priced|pricing|cost|costs|cheap\w*|afford\w*|budget|expensive"
+    r"|pricey|bargain|deals?|discount\w*|sale|value|rated|rating\w*|ratings|stars?"
+    r"|reviews?|under|below|cheaper|cheapest|lowest|highest)\b",
+    re.IGNORECASE,
+)
 
 
 def recommend_products(query, catalog, model, limit=5):
