+def _calendar(meeting_date: date) -> str:
+    """The Monday of the meeting's week to the Sunday after next, one day per line."""
+    start = meeting_date - timedelta(days=meeting_date.weekday())
+    days = [start + timedelta(days=offset) for offset in range(14)]
+    return "\n".join(f"{_DAYS[day.weekday()]} {day.isoformat()}" for day in days)
+
