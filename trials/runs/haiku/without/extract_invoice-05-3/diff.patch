+    def test_vat_invoice_that_adds_up_is_ok(self):
+        # BP-2291 as printed: lines 309.00, VAT at 20% 61.80, amount due 370.80.
+        result = extract(subtotal=309, vat="61.80", total="370.80")
+        self.assertEqual(result["lines_total"], Decimal("309.00"))
+        self.assertEqual(result["vat"], Decimal("61.80"))
+        self.assertEqual(result["total"], Decimal("370.80"))
+        self.assertEqual(result["status"], "ok")
+
+    def test_amount_due_not_matching_subtotal_and_vat_is_a_mismatch(self):
+        result = extract(subtotal=309, vat="61.80", total="370.90")
+        self.assertEqual(result["status"], "mismatch")
+
+    def test_vat_not_matching_the_subtotal_is_a_mismatch(self):
