@@ -91,6 +96,28 @@
     return value.strip()
 
 
+def _issue_date(raw, date_order):
+    iso = ISO_DATE.fullmatch(raw)
+    numeric = NUMERIC_DATE.fullmatch(raw)
+    if numeric and date_order is None:
+        # 05/08/2026 is 5 August in Britain and 8 May in the US; never pick one.
+        raise InvoiceError(
+            f"issue_date {raw!r} is numeric and the supplier's day/month order is not known"
+        )
+    if iso:
+        fields = iso.groups()
+    elif numeric:
+        first, second, year = numeric.groups()
+        day, month = (first, second) if date_order == "dmy" else (second, first)
+        fields = (year, month, day)
+    else:
+        raise InvoiceError(f"issue_date is not a date: {raw!r}")
+    try:
+        return date(*map(int, fields))
+    except ValueError:
+        raise InvoiceError(f"issue_date is not a date: {raw!r}") from None
+
+
 def _number(value, label):
