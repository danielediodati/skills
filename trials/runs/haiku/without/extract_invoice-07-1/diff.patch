+def _issue_date(raw, date_order):
+    # Dates with a written-out month, or in ISO form, have only one reading.
+    match = ISO_DATE.fullmatch(raw)
+    if match:
+        return _make_date(int(match[1]), int(match[2]), int(match[3]), raw)
+    match = DAY_MONTH_NAME.fullmatch(raw)
+    if match and match[2].lower() in MONTHS:
+        return _make_date(int(match[3]), MONTHS[match[2].lower()], int(match[1]), raw)
+    match = MONTH_NAME_DAY.fullmatch(raw)
+    if match and match[1].lower() in MONTHS:
+        return _make_date(int(match[3]), MONTHS[match[1].lower()], int(match[2]), raw)
+
+    # Numeric dates: 05/08/2026 is 5 August in the UK and 8 May in the US.
+    match = NUMERIC_DATE.fullmatch(raw)
+    if not match:
+        raise InvoiceError(f"issue_date is not a date: {raw!r}")
+    first, second, year = int(match[1]), int(match[3]), int(match[4])
+    if first == second:
+        return _make_date(year, first, first, raw)
+    if first > 12 >= second:
+        return _make_date(year, second, first, raw)
+    if second > 12 >= first:
+        return _make_date(year, first, second, raw)
+    if date_order == "DMY":
+        return _make_date(year, second, first, raw)
+    if date_order == "MDY":
+        return _make_date(year, first, second, raw)
+    raise InvoiceError(f"issue_date is ambiguous, no date order on file: {raw!r}")
+
+
+def _make_date(year, month, day, raw):
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise InvoiceError(f"issue_date is not a date: {raw!r}") from None
 
 
