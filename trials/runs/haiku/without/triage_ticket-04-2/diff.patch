+def _without_quoted_history(body):
+    """Drop the earlier messages a mail client quotes into a reply.
+
+    Quoted lines start with ">". An "Original Message" marker means the
+    quoted thread follows it, so everything from there on is dropped.
+    If nothing is left, the body is used as it was.
+    """
+    kept = []
+    for line in body.splitlines():
+        if ORIGINAL_MESSAGE.match(line):
+            break
+        if line.lstrip().startswith(">") or QUOTE_HEADER.match(line):
+            continue
+        kept.append(line)
+    stripped = "\n".join(kept).strip()
+    return stripped or body
+
+
+def _shorten(body):
+    """Keep the start and the end of a long body, since either can hold the request."""
+    if len(body) <= MAX_BODY_CHARS:
+        return body
+    return body[:HEAD_CHARS] + "\n[... middle of message omitted ...]\n" + body[-TAIL_CHARS:]
+
+
