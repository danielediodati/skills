+def _without_quoted_text(body):
+    # Quoted earlier emails can run to pages and sit above or below what the
+    # customer wrote, so they are removed wherever they appear.
+    kept = []
+    for line in body.splitlines():
+        if FORWARD_MARKER.match(line):
+            # Everything from an Outlook-style "Original Message" on is old text.
+            break
+        if QUOTED_LINE.match(line) or REPLY_HEADER.search(line):
+            continue
+        kept.append(line)
+    return "\n".join(kept).strip()
+
+
+def _shorten(text, limit):
+    # Keep both ends: a reply may open with the request or close with it.
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + "\n[... part of the message left out ...]\n" + text[-half:]
+
+
