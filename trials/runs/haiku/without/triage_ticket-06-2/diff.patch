+NOT_A_PASSWORD = (
+    r"(?!(?:is|was|not|reset|resets|link|email|expired|change|update|manager|page"
+    r"|screen|field|prompt|form|request|isn't|doesn't|didn't|won't|wrong|incorrect"
+    r"|invalid|rejected|fails?|failed|failing|required|requirements?|policy|strength"
+    r"|recovery|help|issue|problem|error)\b)"
+)
+SECRETS = (
+    # Card numbers: 13 to 19 digits, optionally grouped by spaces or dashes.
+    (re.compile(r"\b(?:\d[ -]?){12,18}\d\b"), "[card number]"),
+    # Security codes next to their label, e.g. "CVC 318" or "cvv: 4421".
+    (re.compile(r"(?i)\b(cvc2?|cvv2?|csc|security\s+code)(\W{0,3})\d{3,4}\b"), r"\1\2[code]"),
+    # Passwords and PINs, e.g. "password Tulip-Harbour-92" or "password is hunter2".
+    (
+        re.compile(
+            r"(?i)\b(password|passcode|passphrase|pin)\b(\s*(?:is|was|:|=)?\s*)"
+            + NOT_A_PASSWORD + r"[^\s.,;!?]\S*?(?=[.,;!?]*(?:\s|$))"
+        ),
+        r"\1\2[password]",
