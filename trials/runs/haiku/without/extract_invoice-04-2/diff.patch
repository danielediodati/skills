+def _plain_digits(text, label, value):
+    # Reads "1.250,00" (European) and "1,250.00" (English) alike; the separator
+    # written last is the decimal point, the other one groups thousands.
+    cleaned = re.sub(r"\s", "", text)
+    if "," in cleaned and "." in cleaned:
+        if cleaned.rfind(",") > cleaned.rfind("."):
+            cleaned = cleaned.replace(".", "").replace(",", ".")
+        else:
+            cleaned = cleaned.replace(",", "")
+    elif cleaned.count(",") > 1:
+        cleaned = cleaned.replace(",", "")
+    elif cleaned.count(".") > 1:
+        cleaned = cleaned.replace(".", "")
+    elif re.search(r",\d{3}$", cleaned):
+        # "1,250" could be one thousand two hundred and fifty or one and a quarter.
+        raise InvoiceError(f"{label} is ambiguous: {value!r}")
+    else:
+        cleaned = cleaned.replace(",", ".")
+    if not re.fullmatch(r"[+-]?\d+(\.\d+)?([eE][+-]?\d+)?", cleaned):
