+
+def _whole_sentences(reason):
+    """Return `reason` if it fits, else its leading whole sentences that fit, else ""."""
+    if len(reason) <= MAX_REASON_CHARS:
+        return reason
+    ends = [m.end() for m in SENTENCE_END.finditer(reason) if m.end() <= MAX_REASON_CHARS]
+    return reason[:ends[-1]] if ends else ""
 
 
