 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """Return the one attendee that `text` names, or None if none or several do.
+
+    A full name, a first name, a nickname or a surname with an initial all
+    count. Exact first names are tried before nicknames, so "Tom" finds
+    "Tom Becker" even when there is also a "Tomas" in the meeting.
+    """
+    written = _words(text)
+    if not written:
+        return None
+    for nicknames in (False, True):
+        matches = [
+            name
+            for name in attendees
+            if _names_person(written, _words(name), nicknames)
+        ]
+        if matches:
+            return matches[0] if len(matches) == 1 else None
+    return None
+
+
+def _words(text: str) -> List[str]:
+    return [word for word in (w.strip(".,") for w in _key(text).split()) if word]
+
+
+def _names_person(written: List[str], full: List[str], nicknames: bool) -> bool:
+    if len(written) == 1:
+        return _same_name(written[0], full[0], nicknames) or written[0] == full[-1]
+    return _same_name(written[0], full[0], nicknames) and _same_surname(
+        written[-1], full[-1]
+    )
+
+
+def _same_name(a: str, b: str, nicknames: bool) -> bool:
+    if a == b:
+        return True
+    # "Tommy" for "Tom", or "Tom" for "Tomas": only long enough to be meant.
+    short = min(len(a), len(b))
+    return nicknames and short >= 3 and (a.startswith(b) or b.startswith(a))
+
+
+def _same_surname(written: str, surname: str) -> bool:
+    if len(written) == 1:  # an initial, as in "Ana R."
+        return surname.startswith(written)
+    return written == surname
 
 
