+def _issue_date(printed, date_order):
+    # Only a numeric date can be read two ways; anything else names its own month.
+    iso = ISO_DATE.fullmatch(printed)
+    if iso:
+        return _make_date(printed, *map(int, (iso[1], iso[2], iso[3])))
+
+    numeric = NUMERIC_DATE.fullmatch(printed)
+    if numeric:
+        first, second, year = map(int, numeric.groups())
+        if first > 12 >= second:
+            day, month = first, second
+        elif second > 12 >= first:
+            day, month = second, first
+        elif first == second:
+            day = month = first
+        elif date_order == "DMY":
+            day, month = first, second
+        elif date_order == "MDY":
+            day, month = second, first
+        else:
+            raise InvoiceError(
+                f"issue_date is ambiguous: {printed!r} could be day-first or month-first, "
+                "and the supplier's date order is not known"
+            )
+        return _make_date(printed, year, month, day)
+
+    named = DAY_MONTH_NAME.fullmatch(printed)
+    if named and named[2].lower() in MONTHS:
+        return _make_date(printed, int(named[3]), MONTHS[named[2].lower()], int(named[1]))
+    named = MONTH_NAME_DAY.fullmatch(printed)
+    if named and named[1].lower() in MONTHS:
+        return _make_date(printed, int(named[3]), MONTHS[named[1].lower()], int(named[2]))
+
+    raise InvoiceError(f"issue_date is not a date: {printed!r}")
+
+
+def _make_date(printed, year, month, day):
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise InvoiceError(f"issue_date is not a date: {printed!r}") from None
 
 
