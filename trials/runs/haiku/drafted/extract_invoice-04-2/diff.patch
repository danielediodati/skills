+def _plain_decimal(text):
+    # "1.250,00" (German, Italian) and "1,250.00" (English) both mean
+    # 1250.00: the separator written last is the decimal mark, the other
+    # is a thousands separator. A lone comma is a decimal mark only when
+    # one or two digits follow it, since "1,250" could mean either.
+    if "," in text and "." in text:
+        if text.rfind(",") > text.rfind("."):
+            return text.replace(".", "").replace(",", ".")
+        return text.replace(",", "")
+    if re.fullmatch(r"[+-]?\d+,\d{1,2}", text):
+        return text.replace(",", ".")
+    return text
+
