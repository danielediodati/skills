 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _parse_owners(text: str, by_name: Dict[str, str]) -> Tuple[str, ...]:
+    """Attendees named in `text`: one name, or several joined by ; , & + / or "and"."""
+    if _key(text) in by_name:
+        return (by_name[_key(text)],)
+    owners: List[str] = []
+    for part in _OWNER_SEP.split(text):
+        name = by_name.get(_key(part))
+        if name and name not in owners:
+            owners.append(name)
+    return tuple(owners)
 
 
