+# An amount as a person writes it: an optional sign, an optional currency symbol
+# or code on either side, and digits with thousands and decimal separators.
+_WRITTEN = re.compile(
+    r"([-+−]?)\s*([^\d\s.,'’+\-−()]+)?\s*([-+−]?)\s*"
+    r"(\d(?:[\d.,'’\s]*\d)?)\s*([^\d\s.,'’+\-−()]+)?\s*([-+−]?)"
+)
+
+
+def _written_amount(text):
+    """Read an amount like `1.234,56`, `£1,234.56` or `1'050.00 CHF`.
+
+    Return None when it is not an amount or can be read two ways (`1.234`).
+    """
+    text = text.strip()
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative, text = True, text[1:-1].strip()
+    match = _WRITTEN.fullmatch(text)
+    if not match:
+        return None
+    signs = [sign for sign in (match[1], match[3], match[6]) if sign]
+    if len(signs) > 1 or (signs and negative):
+        return None
+    negative = negative or bool(signs and signs[0] in "-−")
+
+    digits = match[4]
+    parts = re.split(r"[.,'’\s]", digits)
+    seps = [("'" if c == "’" else " " if c.isspace() else c)
+            for c in re.findall(r"[.,'’\s]", digits)]
+    if "" in parts:
+        return None
+
+    decimal = None
+    marks = [c for c in seps if c in ".,"]
+    if len(set(marks)) == 2:
+        if seps[-1] not in ".," or seps.count(seps[-1]) != 1:
+            return None
+        decimal = seps[-1]
+    elif len(marks) == 1 and seps.count(marks[0]) == 1:
+        soft = len(seps) > 1
+        # `1.234` is a thousand or a decimal and nothing in it says which.
+        thousands_shaped = len(parts[-1]) == 3 and 1 <= len(parts[0]) <= 3
+        if soft or not thousands_shaped or parts[0] == "0":
+            decimal = marks[0]
+        else:
+            return None
+    if decimal:
+        if seps[-1] != decimal:
+            return None
+        whole, fraction = parts[:-1], parts[-1]
+        grouping = set(seps[:-1])
+    else:
+        whole, fraction = parts, ""
+        grouping = set(seps)
+    if len(grouping) > 1:
+        return None
+    if len(whole) > 1 and not (
+        1 <= len(whole[0]) <= 3 and all(len(group) == 3 for group in whole[1:])
+    ):
+        return None
+
+    number = Decimal("".join(whole) + ("." + fraction if decimal else ""))
+    return -number if negative else number
+
+
 def _cents(amount):
     return amount.quantize(CENT, rounding=ROUND_HALF_UP)
