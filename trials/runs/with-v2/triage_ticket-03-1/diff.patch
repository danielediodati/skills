+def _fit(text, limit):
+    """Shorten `text` to `limit` characters without breaking a word.
+
+    Whole leading sentences are kept when they fit; otherwise whole words.
+    A shortened text ends with the ELLIPSIS mark.
+    """
+    if len(text) <= limit:
+        return text
+    room = limit - len(ELLIPSIS)
+
+    kept = ""
+    for sentence in SENTENCE_END.split(text):
+        candidate = f"{kept} {sentence}" if kept else sentence
+        if len(candidate) > room:
+            break
+        kept = candidate
+    if kept:
+        return kept + ELLIPSIS
+
+    # No sentence fits: cut at the last space, or hard if there is none.
+    head = text[:room + 1]
+    cut = head.rfind(" ")
+    head = head[:cut] if cut > 0 else text[:room]
+    return head.rstrip(" ,;:-") + ELLIPSIS
 
 
