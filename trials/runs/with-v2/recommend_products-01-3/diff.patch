 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
 
+_NUMBER = r"(\d+(?:,\d{3})*(?:[.,]\d{1,2})?)"
+_MONEY = rf"(?:€\s*)?{_NUMBER}(?:\s*(?:€|euros?|eur)\b)?"
+_RANGE = re.compile(
+    rf"\b(?:between|from)\s+{_MONEY}\s+(?:and|to|-)\s+{_MONEY}", re.IGNORECASE)
+# (phrase, is_upper_bound, bound_is_inclusive)
+_BOUND_WORDS = [
+    (r"up\s+to|at\s+most|no\s+more\s+than|maximum|max|within", True, True),
+    (r"under|below|less\s+than|cheaper\s+than", True, False),
+    (r"at\s+least|minimum|min|from", False, True),
+    (r"over|above|more\s+than", False, False),
+]
+_BOUNDS = [
+    (re.compile(rf"\b(?:{words})\.?\s+{_MONEY}", re.IGNORECASE), upper, inclusive)
+    for words, upper, inclusive in _BOUND_WORDS
+]
+
+
+def _to_number(text):
+    if re.fullmatch(r"\d+(?:,\d{3})+", text):
+        return float(text.replace(",", ""))
+    return float(text.replace(",", "."))
+
+
+def price_limits(query):
+    """Return (low, high, low_inclusive, high_inclusive) stated in `query`; None where absent."""
+    low = high = None
+    low_inc = high_inc = True
+    ranged = _RANGE.search(query)
+    if ranged:
+        a, b = _to_number(ranged.group(1)), _to_number(ranged.group(2))
+        low, high = min(a, b), max(a, b)
+        query = query[:ranged.start()] + " " + query[ranged.end():]
+    for pattern, upper, inclusive in _BOUNDS:
+        for match in pattern.finditer(query):
+            value = _to_number(match.group(1))
+            if upper and (high is None or value < high):
+                high, high_inc = value, inclusive
+            elif not upper and (low is None or value > low):
+                low, low_inc = value, inclusive
+    return low, high, low_inc, high_inc
+
+
+def _within(price, limits):
+    low, high, low_inc, high_inc = limits
+    if low is not None and (price < low or (price == low and not low_inc)):
+        return False
+    if high is not None and (price > high or (price == high and not high_inc)):
+        return False
+    return True
+
 
