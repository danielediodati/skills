+def _fit(text, limit):
+    """Shorten `text` to `limit` characters without cutting a word.
+
+    Whole leading sentences are kept when they fit; otherwise the text is cut
+    at a word boundary. A shortened text ends with an ellipsis.
+    """
+    if len(text) <= limit:
+        return text
+
+    # Room for the marker: " …" after whole sentences.
+    kept = ""
+    for match in SENTENCE_END.finditer(text):
+        if match.end() + 2 > limit:
+            break
+        kept = text[:match.end()]
+    if kept:
+        return kept + " " + ELLIPSIS
+
+    head = text[:limit - 1]
+    if text[limit - 1] != " " and " " in head:
+        head = head[:head.rindex(" ")]
+    return head.rstrip(" ,;:-") + ELLIPSIS
 
 
