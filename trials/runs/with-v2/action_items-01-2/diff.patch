 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, by_name: Dict[str, str]) -> Optional[str]:
+    """Match the model's owner to an attendee, or None.
+
+    The full name matches directly. Otherwise the words given (a first name,
+    a surname) must belong to exactly one attendee; if two could be meant, the
+    item is left unassigned rather than given to the wrong one.
+    """
+    key = _key(text)
+    if key in by_name:
+        return by_name[key]
+    if key in _EMPTY:
+        return None
+    words = set(key.split())
+    matches = [name for k, name in by_name.items() if words <= set(k.split())]
+    return matches[0] if len(matches) == 1 else None
 
 
