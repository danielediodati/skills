+def _fit(text, limit):
+    """Fit one line into `limit` characters without cutting a word.
+
+    Whole leading sentences are kept when they fit; otherwise the text is cut
+    at a word boundary. A shortened text ends with an ellipsis.
+    """
+    if len(text) <= limit:
+        return text
+
+    kept = ""
+    for sentence in SENTENCE_END.split(text):
+        candidate = f"{kept} {sentence}" if kept else sentence
+        if len(candidate) + len(" " + ELLIPSIS) > limit:
+            break
+        kept = candidate
+    if kept:
+        return f"{kept} {ELLIPSIS}"
+
+    room = limit - len(ELLIPSIS)
+    cut = text[:room]
+    if text[room] != " " and " " in cut:
+        cut = cut.rsplit(" ", 1)[0]
+    return cut.rstrip(" ,;:-") + ELLIPSIS
 
 
