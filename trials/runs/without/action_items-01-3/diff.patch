 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """Match `text` to an attendee: a full name, or a part of a name (such as
+    a first name) that fits exactly one attendee. Ambiguous or unknown gives None.
+    """
+    key = _key(text)
+    if key in _EMPTY:
+        return None
+    for name in attendees:
+        if _key(name) == key:
+            return name
+    wanted = key.split()
+    matches = [
+        name for name in attendees if _contains_words(_key(name).split(), wanted)
+    ]
+    # Two attendees spelled the same way are still one candidate name.
+    if len({_key(name) for name in matches}) == 1:
+        return matches[0]
+    return None
+
+
+def _contains_words(words: List[str], wanted: List[str]) -> bool:
+    return all(word in words for word in wanted)
 
 
