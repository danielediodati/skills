 def recommend_products(query, catalog, model, limit=5):
     """Return up to `limit` in-stock products for `query`, best first.
+
+    The model's picks come first (`"filler": False`). If there are fewer than
+    `limit`, the best-rated remaining in-stock products follow, highest rating
+    first, marked `"filler": True` and with an empty reason.
 
     `catalog` is a list of dicts with "id", "name", "price", "rating" and "in_stock".
     `model` is a callable taking a prompt string and returning a string.
@@ -54,7 +58,26 @@
             "price": product["price"],
             "rating": product["rating"],
             "reason": " ".join(reason.split())[:MAX_REASON_CHARS],
+            "filler": False,
         })
         if len(picks) == limit:
             break
+
+    # Too few suitable picks: top up with the best-rated in-stock products.
+    # sorted() is stable, so equal ratings keep catalogue order.
+    by_rating = sorted(available.values(), key=lambda p: p["rating"], reverse=True)
+    for product in by_rating:
+        if len(picks) == limit:
+            break
+        if product["id"] in seen:
+            continue
+        seen.add(product["id"])
+        picks.append({
+            "id": product["id"],
+            "name": product["name"],
+            "price": product["price"],
+            "rating": product["rating"],
+            "reason": "",
+            "filler": True,
+        })
     return picks
