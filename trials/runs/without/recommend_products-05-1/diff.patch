 Pick up to {limit} products from the list that best match the search, best first.
 Answer with one product per line, as: ID | one short reason, addressed to the customer
+Each reason must be a complete sentence of at most {max_chars} characters.
 
 Products (ID | name | price | rating out of 5):
 {products}
 """
 
+SHORTEN_PROMPT = """These reasons are shown under products and are too long.
+Rewrite each one as a complete sentence of at most {max_chars} characters that keeps its main point.
+Answer with one product per line, as: ID | reason
+
+{reasons}
+"""
+
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+
+def _parse(answer):
+    """Yield (product_id, reason) for each `ID | reason` line of a model answer."""
+    for line in answer.splitlines():
+        product_id, _, reason = LIST_MARKER.sub("", line).partition("|")
+        yield product_id.strip(), " ".join(reason.split())
+
+
+def _shorten_locally(reason):
+    """Longest whole sentence or clause of `reason` that fits, or "" if none does."""
+    for ends in (".!?", ",;:"):
+        for match in reversed(list(re.finditer(rf"[{re.escape(ends)}](?=\s|$)", reason))):
+            if match.end() <= MAX_REASON_CHARS:
+                return reason[:match.end()].rstrip(",;:")
+    return ""
 
 
 def recommend_products(query, catalog, model, limit=5):
