 """
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
+
+NUMBER = re.compile(r"\d+(?:[.,]\d{3})*(?:[.,]\d{1,2})?|\d+")
+CURRENCY_BEFORE = re.compile(r"(?:[€$£]|(?:EUR|USD|GBP))\s*$", re.IGNORECASE)
+CURRENCY_AFTER = re.compile(
+    r"^\s*(?:[€$£]|(?:EUR|USD|GBP|euros?|dollars?|pounds?))", re.IGNORECASE)
+PRICE_CUE_BEFORE = re.compile(
+    r"(?:at|only|just|for|costs?|price|priced|under|from)\s*$", re.IGNORECASE)
+WORD_AFTER = re.compile(r"^\s*[A-Za-z]")
+
+
+def _parse_number(text):
+    match = re.search(r"[.,](\d{1,2})$", text)
+    if match:
+        whole = re.sub(r"[.,]", "", text[:match.start()])
+        return float(f"{whole}.{match.group(1)}")
+    return float(re.sub(r"[.,]", "", text))
+
+
+def _states_other_price(reason, price):
+    """True if `reason` quotes a price that is not `price`."""
+    for match in NUMBER.finditer(reason):
+        before = reason[:match.start()]
+        after = reason[match.end():]
+        priced = (
+            CURRENCY_BEFORE.search(before)
+            or CURRENCY_AFTER.search(after)
+            or re.fullmatch(r"\d+[.,]\d{2}", match.group())
+            or (PRICE_CUE_BEFORE.search(before) and not WORD_AFTER.search(after))
+        )
+        if priced and abs(_parse_number(match.group()) - price) >= 0.005:
+            return True
+    return False
 
 
 def recommend_products(query, catalog, model, limit=5):
