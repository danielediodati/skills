+def _without_quoted_text(body):
+    """Drop earlier messages quoted in a reply, wherever they sit.
+
+    Removes `>` quoted lines, the "On ... wrote:" line introducing them and
+    everything after an "-----Original Message-----" separator.
+    """
+    kept = []
+    previous_quoted = False
+    for line in body.splitlines():
+        if ORIGINAL_MESSAGE.match(line):
+            break
+        quoted = bool(QUOTED_LINE.match(line))
+        if quoted:
+            if not previous_quoted:
+                _drop_attribution(kept)
+        elif line.strip() or not previous_quoted:
+            kept.append(line)
+        previous_quoted = quoted or (previous_quoted and not line.strip())
+    return "\n".join(kept).strip()
+
+
+def _drop_attribution(kept):
+    """Remove a trailing "On <date>, <name> wrote:" line (possibly wrapped)."""
+    while kept and not kept[-1].strip():
+        kept.pop()
+    if kept and ATTRIBUTION_END.search(kept[-1]):
+        line = kept.pop()
+        if not ATTRIBUTION_START.match(line) and kept and ATTRIBUTION_START.match(kept[-1]):
+            kept.pop()
+
+
