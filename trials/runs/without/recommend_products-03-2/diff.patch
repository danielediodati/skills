 """Pick the products to show a shopper for a search, each with a short reason."""
 
 import re
+from decimal import Decimal
 
 MAX_REASON_CHARS = 80
 
@@ -15,12 +16,49 @@
 
 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
 
+NUMBER = re.compile(r"\d+(?:[.,]\d+)*")
+CURRENCY_BEFORE = re.compile(r"(?:€|\$|£|\b(?:EUR|USD|GBP))\s*$", re.IGNORECASE)
+CURRENCY_AFTER = re.compile(r"\s*(?:€|\$|£|(?:EUR|USD|GBP|euros?|dollars?|pounds?)\b)", re.IGNORECASE)
+PRICE_WORD_BEFORE = re.compile(r"\b(?:at|only|just|costs?|price|priced)\s+$", re.IGNORECASE)
+MEASURE_AFTER = re.compile(
+    r"\s*(?:%|-|(?:mm|cm|m|km|g|kg|ml|l|w|v|h|hz|db|mah|gb|tb|hours?|hrs?|min|minutes?|days?|years?)\b)",
+    re.IGNORECASE,
+)
+
+
+def _amount(token):
+    """The value of a number as written ("1.299,00", "14,90", "4")."""
+    match = re.search(r"[.,](\d{1,2})$", token)
+    if match:
+        whole = re.sub(r"[.,]", "", token[:match.start()])
+        return Decimal(f"{whole}.{match.group(1)}")
+    return Decimal(re.sub(r"[.,]", "", token))
+
+
+def states_other_price(reason, price):
+    """True if `reason` quotes a price that is not `price`."""
+    actual = Decimal(str(price)).quantize(Decimal("0.01"))
+    for match in NUMBER.finditer(reason):
+        before, after = reason[:match.start()], reason[match.end():]
+        token = match.group()
+        has_cents = re.search(r"[.,]\d{2}$", token) is not None
+        is_price = (
+            CURRENCY_BEFORE.search(before)
+            or CURRENCY_AFTER.match(after)
+            or (has_cents and not MEASURE_AFTER.match(after))
+            or (PRICE_WORD_BEFORE.search(before) and not MEASURE_AFTER.match(after))
+        )
+        if is_price and _amount(token).quantize(Decimal("0.01")) != actual:
+            return True
+    return False
+
 
