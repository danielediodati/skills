+            "gift up to €9,5": {"C-010", "C-020"},
+            "less than 9.5": {"C-010"},
+            "under 9.50": {"C-010"},
+            "over 100": {"H-100"},
+            "from 129": {"H-100"},
+            "over 129": set(),
+            "between 8 and 20 euro": {"H-200", "C-020"},
+            "from 8 to 20": {"H-200", "C-020"},
+            "Headphones UNDER $50": {"H-200", "C-010", "C-020"},
+            "cable over 5 under 9": {"C-010"},
+        }
+        everything = "\n".join(p["id"] + " | x" for p in CATALOG)
