 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, by_name: Dict[str, str]) -> Optional[str]:
+    """Map the owner the model wrote to exactly one attendee, or None.
+
+    Accepts the full name, a first or last name alone, a nickname that shares
+    its start with the real name ("Tommy" for "Tom"), and initials ("Ana R.").
+    If more than one attendee fits, nobody is chosen.
+    """
+    exact = by_name.get(_key(text))
+    if exact is not None:
+        return exact
+    given = re.findall(r"\w+", text.casefold())
+    if not given:
+        return None
+    fits = [
+        name
+        for key, name in by_name.items()
+        if _fits(given, re.findall(r"\w+", key))
+    ]
+    return fits[0] if len(fits) == 1 else None
+
+
+def _fits(given: List[str], name_parts: List[str]) -> bool:
+    full = [part for part in given if len(part) > 1]
+    if not full:  # initials alone say too little
+        return False
+    return all(
+        any(_same_part(part, candidate) for candidate in name_parts)
+        for part in given
+    )
+
+
+def _same_part(part: str, candidate: str) -> bool:
+    if len(part) == 1:
+        return candidate.startswith(part)
+    if part == candidate:
+        return True
+    short, long_ = sorted((part, candidate), key=len)
+    return len(short) >= 3 and long_.startswith(short)
 
 
