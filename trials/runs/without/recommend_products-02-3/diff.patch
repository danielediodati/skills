 def recommend_products(query, catalog, model, limit=5):
     """Return up to `limit` in-stock products for `query`, best first.
+
+    The model's picks come first (`"filler": False`). If there are fewer than
+    `limit`, the rest are the best-rated unpicked in-stock products, highest
+    rating first, marked `"filler": True` and with an empty reason.
 
     `catalog` is a list of dicts with "id", "name", "price", "rating" and "in_stock".
     `model` is a callable taking a prompt string and returning a string.
@@ -54,7 +58,26 @@
             "price": product["price"],
             "rating": product["rating"],
             "reason": " ".join(reason.split())[:MAX_REASON_CHARS],
+            "filler": False,
         })
         if len(picks) == limit:
             break
+
+    if len(picks) < limit:
+        # Top up with the best-rated in-stock products not already picked.
+        # sorted() is stable, so equal ratings keep catalogue order.
+        spare = sorted(
+            (p for p in available.values() if p["id"] not in seen),
+            key=lambda p: p["rating"],
+            reverse=True,
+        )
+        for product in spare[:limit - len(picks)]:
+            picks.append({
+                "id": product["id"],
+                "name": product["name"],
+                "price": product["price"],
+                "rating": product["rating"],
+                "reason": "",
+                "filler": True,
+            })
     return picks
