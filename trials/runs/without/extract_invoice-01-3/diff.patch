+    def test_amounts_as_suppliers_write_them_are_read(self):
+        cases = {
+            "1.234,56": "1234.56",
+            "1,234.56": "1234.56",
+            "£1,234.56": "1234.56",
+            "1'050.00 CHF": "1050.00",
+            "1’050.00": "1050.00",
+            "EUR 1 234,56": "1234.56",
+            "1 234,56 €": "1234.56",
+            "1.234.567,8": "1234567.8",
+            "1,234,567": "1234567",
+            "12,50": "12.5",
+            "1234.567": "1234.567",
+            "0.335": "0.335",
+            "-£5.00": "-5.00",
+            "$ 1,000.00 USD": "1000.00",
+            "15.00": "15.00",
+            "1e2": "100",
+        }
+        for written, expected in cases.items():
+            with self.subTest(written):
+                lines = [{"description": "x", "quantity": 1, "unit_price": written}]
+                result = extract(lines=lines, total=written)
+                self.assertEqual(result["lines"][0]["unit_price"], Decimal(expected))
+                self.assertEqual(result["total"], Decimal(expected).quantize(Decimal("0.01")))
