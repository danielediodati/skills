+_SPACES = "    "
+
+
+def _plain_amount(value, label):
+    """Rewrite an amount as printed ('£1,234.56', "1'050.00 CHF", '1.234,56') as '1234.56'.
+
+    Returns the text unchanged when it holds no digits to interpret, so the caller
+    reports it as not a number. Raises InvoiceError when the separators can be read
+    two ways, as in '1.234' or '1,234'.
+    """
+    not_number = InvoiceError(f"{label} is not a number: {value!r}")
+    text = value.strip().replace("’", "'")
+    if re.fullmatch(r"[+-]?\d+(\.\d+)?[eE][+-]?\d+", text):
+        return text
+
+    def trim(s):
+        return s.strip(_SPACES + "\t\n").strip("".join(
+            c for c in set(s) if c.isalpha() or unicodedata.category(c) == "Sc"
+        )).strip(_SPACES + "\t\n")
+
+    # A currency may sit on either side of the sign: "-£5", "£-5", "5 EUR".
+    core = trim(text)
+    sign = ""
+    if core[:1] in "+-" and core:
+        sign, core = core[0], trim(core[1:])
+    body = core.replace(" ", " ").replace(" ", " ").replace(" ", " ")
+    if not re.fullmatch(r"\d(?:[\d.,' ]*\d)?", body):
+        raise not_number
+
+    seps = set(body) - set("0123456789")
+    marks = seps & set(".,")
+    spacers = seps & set("' ")
+    if len(spacers) > 1:
+        raise not_number
+
+    group = next(iter(spacers), None)
+    decimal = None
+    if len(marks) == 2:
+        if group:
+            raise not_number
+        decimal = body[max(body.rfind("."), body.rfind(","))]
+        group = (marks - {decimal}).pop()
+    elif len(marks) == 1:
+        mark = marks.pop()
+        if group:
+            decimal = mark
+        elif body.count(mark) > 1:
+            group = mark
+        else:
+            left, right = body.split(mark)
+            if len(right) == 3 and 1 <= len(left) <= 3 and not left.startswith("0"):
+                raise InvoiceError(
+                    f"{label} is ambiguous, {mark!r} may be a decimal or a thousands "
+                    f"separator: {value!r}"
+                )
+            decimal = mark
+
+    whole, frac = body.rsplit(decimal, 1) if decimal else (body, "")
+    if decimal and not frac.isdigit():
+        raise not_number
+    groups = whole.split(group) if group else [whole]
+    if not all(g.isdigit() for g in groups):
+        raise not_number
+    if len(groups) > 1 and not (len(groups[0]) <= 3 and all(len(g) == 3 for g in groups[1:])):
+        raise not_number
+    return f"{sign}{''.join(groups)}" + (f".{frac}" if decimal else "")
+
