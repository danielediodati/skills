+def _plain_number(text, error):
+    """Rewrite a written amount such as '1.250,00' or "1'250.00" as '1250.00'.
+
+    Anything that is not a grouped or decimal number is returned unchanged.
+    A lone separator followed by exactly three digits ('1.250', '1,250') could
+    be a thousands mark or a decimal point, so it is refused rather than guessed.
+    """
+    compact = re.sub(r"[\s  ']", "", text)
+    match = re.fullmatch(r"([+-]?)(\d[\d.,]*)", compact)
+    if not match or not re.search(r"[.,]", compact):
+        return text
+    sign, digits = match.groups()
+    last = max(digits.rfind("."), digits.rfind(","))
+    head, sep, tail = digits[:last], digits[last], digits[last + 1:]
+    other = "," if sep == "." else "."
+    if other in head or head.count(sep):
+        # Both kinds present: the last one is the decimal mark.
+        # Same kind repeated with nothing else: all are thousands marks.
+        if head.count(sep) and other not in head:
+            groups = digits.split(sep)
+            if not all(len(g) == 3 for g in groups[1:]) or not 1 <= len(groups[0]) <= 3:
+                raise InvoiceError(error)
+            return sign + "".join(groups)
+        integer, decimals = head, tail
+        groups = integer.split(other)
+        if (head.count(sep) or not all(len(g) == 3 for g in groups[1:])
+                or not 1 <= len(groups[0]) <= 3):
+            raise InvoiceError(error)
+        return sign + "".join(groups) + "." + decimals
+    if len(tail) == 3 and head != "0" and head != "":
+        raise InvoiceError(f"{error} (ambiguous separator)")
+    return sign + head + "." + tail
+
+
