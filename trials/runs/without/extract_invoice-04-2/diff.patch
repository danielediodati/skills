+    def test_amounts_written_in_any_national_style_are_read(self):
+        cases = {
+            "1.250,00": "1250.00",
+            "1,250.00": "1250.00",
+            "1 250,00": "1250.00",
+            "1'250.00": "1250.00",
+            "2.340,50": "2340.50",
+            "1.234.567,89": "1234567.89",
+            "1.250.000": "1250000",
+            "15,5": "15.5",
+            "0.335": "0.335",
+            "-1.250,00": "-1250.00",
+        }
+        for written, expected in cases.items():
+            with self.subTest(written=written):
+                lines = [{"description": "x", "quantity": 1, "unit_price": written}]
+                result = extract(lines=lines, total=written)
+                self.assertEqual(result["lines"][0]["unit_price"], Decimal(expected))
+                self.assertEqual(result["total"], Decimal(expected).quantize(Decimal("0.01")))
+
