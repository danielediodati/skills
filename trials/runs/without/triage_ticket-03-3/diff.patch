+def _shorten(text, limit):
+    """Fit `text` in `limit` characters, never cutting a word.
+
+    Shortened text ends with an ellipsis. Whole leading sentences are
+    preferred over a fragment of the next one.
+    """
+    if len(text) <= limit:
+        return text
+
+    sentences = SENTENCE_END.split(text)
+    kept = ""
+    for sentence in sentences[:-1]:
+        candidate = f"{kept} {sentence}" if kept else sentence
+        if len(candidate) + len(" " + ELLIPSIS) > limit:
+            break
+        kept = candidate
+    if kept:
+        return f"{kept} {ELLIPSIS}"
+
+    room = limit - len(ELLIPSIS)
+    if text[room].isspace():
+        head = text[:room]
+    elif " " in text[:room]:
+        head = text[:room].rsplit(" ", 1)[0]
+    else:
+        head = text[:room]  # a single word longer than the space: unavoidable
+    return head.rstrip(" ,;:-") + ELLIPSIS
 
 
