+def _parse(answer):
+    """Yield (id, reason) for each `ID | reason` line, reason on one line."""
+    for line in answer.splitlines():
+        product_id, _, reason = LIST_MARKER.sub("", line).partition("|")
+        yield product_id.strip(), " ".join(reason.split())
+
+
+def _shorten_reasons(picks, model):
+    """Make every reason fit MAX_REASON_CHARS without cutting it mid-sentence.
+
+    Over-long reasons are sent back to the model once to be rewritten. Any that
+    still do not fit keep their first complete sentence that fits, or become
+    empty, rather than being cut off in the middle.
+    """
+    too_long = [p for p in picks if len(p["reason"]) > MAX_REASON_CHARS]
+    if not too_long:
+        return
+    wanted = {p["id"] for p in too_long}
+    rewritten = {}
+    answer = model(REWRITE_PROMPT.format(
+        max_chars=MAX_REASON_CHARS,
+        reasons="\n".join(f"{p['id']} | {p['reason']}" for p in too_long),
+    ))
+    for product_id, reason in _parse(answer):
+        if product_id in wanted and product_id not in rewritten:
+            rewritten[product_id] = reason
+    for pick in too_long:
+        reason = rewritten.get(pick["id"], "")
+        if reason and len(reason) <= MAX_REASON_CHARS:
+            pick["reason"] = reason
+        else:
+            pick["reason"] = _whole_sentence(pick["reason"])
+
+
+def _whole_sentence(text):
+    """Longest run of complete sentences from the start of `text` that fits, or ''."""
+    match = re.match(r"(.*[.!?])(?:\s|$)", text[:MAX_REASON_CHARS + 1])
+    return match.group(1) if match else ""
