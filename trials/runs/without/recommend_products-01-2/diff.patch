 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
 
+# One amount, optionally with a leading currency symbol. "30", "30.50", "30,50"
+# and "1,000.50" are understood; amounts followed by a unit ("50 gb") are not prices.
+_AMOUNT = (
+    r"[€$£]?\s*(\d{1,3}(?:[.,]\d{3})+(?:[.,]\d{1,2})?(?!\d)|\d+(?:[.,]\d{1,2})?(?!\d))"
+    r"(?!\s*(?:gb|tb|mb|cm|mm|km|m|kg|g|w|hz|khz|mah|inch|in|%)\b)"
+)
+_RANGE = re.compile(
+    rf"\b(?:between\s+{_AMOUNT}\s+and|from\s+{_AMOUNT}\s+to)\s+{_AMOUNT}"
+)
+# Each pattern gives one bound; the amount is the pattern's only group.
+_BOUNDS = [
+    (re.compile(rf"\b(?:under|below|less\s+than|cheaper\s+than)\s+{_AMOUNT}"),
+     lambda limit: lambda price: price < limit),
+    (re.compile(rf"\b(?:max(?:imum)?|up\s+to|at\s+most|no\s+more\s+than|not\s+more\s+than)\s+{_AMOUNT}"),
+     lambda limit: lambda price: price <= limit),
+    (re.compile(rf"\b(?:over|above|more\s+than)\s+{_AMOUNT}"),
+     lambda limit: lambda price: price > limit),
+    (re.compile(rf"\b(?:from|min(?:imum)?|at\s+least)\s+{_AMOUNT}"),
+     lambda limit: lambda price: price >= limit),
+]
+
+
+def _amount(text):
+    """Parse '30', '30.50', '30,50' or '1,000.50' into a float."""
+    decimals = re.search(r"[.,](\d{1,2})$", text)
+    if decimals:
+        whole = re.sub(r"[.,]", "", text[:decimals.start()])
+        return float(f"{whole}.{decimals.group(1)}")
+    return float(re.sub(r"[.,]", "", text))
+
+
+def price_limits(query):
+    """Return a predicate on prices for the limit stated in `query`, or None."""
+    text = query.lower()
+    checks = []
+
+    def between(match):
+        low, high = sorted(_amount(g) for g in match.groups() if g)
+        checks.append(lambda price: low <= price <= high)
+        return " "
+
+    text = _RANGE.sub(between, text)
+    for pattern, make_check in _BOUNDS:
+        for match in pattern.finditer(text):
+            checks.append(make_check(_amount(match.group(1))))
+    if not checks:
+        return None
+    return lambda price: all(check(round(price, 2)) for check in checks)
+
 
 def recommend_products(query, catalog, model, limit=5):
     """Return up to `limit` in-stock products for `query`, best first.
 
     `catalog` is a list of dicts with "id", "name", "price", "rating" and "in_stock".
     `model` is a callable taking a prompt string and returning a string.
+    A price limit stated in the query ("under 50", "between 20 and 40") is a hard
+    rule: products outside it are never offered to the model nor returned.
     """
     if limit < 1:
         raise ValueError("limit must be at least 1")
     query = " ".join(query.split())
     available = {p["id"]: p for p in catalog if p["in_stock"]}
+    within_limits = price_limits(query)
+    if within_limits:
+        available = {i: p for i, p in available.items() if within_limits(p["price"])}
     if not query or not available:
         return []
 
