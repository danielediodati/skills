+_WEEKDAYS = [
+    "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday",
+]
+
+
+def _weekday_dates(meeting_date: date, weekday: int):
+    """Return (first such day after the meeting, that day in the following week).
+
+    A meeting held on the day itself points a week ahead, never at itself.
+    "Next" means the day in the calendar week (Monday to Sunday) after the
+    meeting's own week.
+    """
+    soon = meeting_date + timedelta(days=(weekday - meeting_date.weekday() - 1) % 7 + 1)
+    next_monday = meeting_date + timedelta(days=7 - meeting_date.weekday())
+    return soon, next_monday + timedelta(days=weekday)
+
+
+def _weekday_table(meeting_date: date) -> str:
+    rows = []
+    for weekday, name in enumerate(_WEEKDAYS):
+        soon, following = _weekday_dates(meeting_date, weekday)
+        rows.append(f"  {name}: by = {soon.isoformat()}, next = {following.isoformat()}")
+    return "\n".join(rows)
+
+
 def _key(text: str) -> str:
