+class SharedOwnerTest(unittest.TestCase):
+    def test_two_owners_stay_on_one_item(self):
+        items = run("Draft the supplier shortlist | Ana Ruiz and tom becker | 2026-03-12")
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0].owners, ("Ana Ruiz", "Tom Becker"))
+        self.assertEqual(items[0].owner, "Ana Ruiz")
+
+    def test_other_separators(self):
+        for field in ("Ana Ruiz; Tom Becker", "Ana Ruiz, Tom Becker", "Ana Ruiz & Tom Becker"):
+            self.assertEqual(run(f"Draft it | {field} | none")[0].owners, ("Ana Ruiz", "Tom Becker"))
+
