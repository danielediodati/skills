+def _strip_quoted(body):
+    """Drop earlier messages quoted in an email reply, keep what is new.
+
+    Removes `>` quoted lines, the "On ... wrote:" line introducing them and
+    everything after an "Original Message" separator, wherever the new text
+    sits relative to the quote.
+    """
+    kept = []
+    for line in body.splitlines():
+        if ORIGINAL_MARKER.match(line):
+            break
+        if QUOTED.match(line):
+            continue
+        if ATTRIBUTION_END.search(line.strip()):
+            if ATTRIBUTION_START.match(line):
+                continue
+            if kept and ATTRIBUTION_START.match(kept[-1]):
+                # The attribution wrapped onto a second line.
+                kept.pop()
+                continue
+        kept.append(line)
+    return "\n".join(kept).strip()
+
