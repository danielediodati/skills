+def _plain_number(value, label):
+    """Rewrite an amount as written on the page ('1.250,00', '1 250,00', "1'250.00")
+    into plain digits with '.' as the decimal point.
+
+    A lone separator followed by exactly three digits ('1.250', '1,250') could be
+    either a thousands group or a decimal fraction, so it is refused rather than guessed.
+    """
+    text = re.sub(r"(?<![A-Za-z])[A-Za-z]{3}(?![A-Za-z])|[€$£]", "", value)
+    text = re.sub(r"[\s  '’]", "", text)
+    if not re.fullmatch(r"[+-]?[\d.,]+", text) or not re.search(r"\d", text):
+        return text  # let Decimal reject it
+    sign = ""
+    if text[0] in "+-":
+        sign, text = text[0] if text[0] == "-" else "", text[1:]
+
+    def bad():
+        return InvoiceError(f"{label} is not a number: {value!r}")
+
+    def grouped(digits, separator):
+        parts = digits.split(separator)
+        return (all(part.isdigit() for part in parts) and 1 <= len(parts[0]) <= 3
+                and all(len(part) == 3 for part in parts[1:]))
+
+    seps = [c for c in text if c in ".,"]
+    if not seps:
+        return sign + text
+    last = max(text.rfind("."), text.rfind(","))
+    if len(set(seps)) == 2:
+        group = "," if text[last] == "." else "."
+        whole, fraction = text[:last], text[last + 1:]
+        if not grouped(whole, group) or not fraction.isdigit():
+            raise bad()
+        return f"{sign}{whole.replace(group, '')}.{fraction}"
+    sep = text[last]
+    if len(seps) > 1:
+        if not grouped(text, sep):
+            raise bad()
+        return sign + text.replace(sep, "")
+    whole, fraction = text.split(sep)
+    if not fraction.isdigit() or (whole and not whole.isdigit()):
+        raise bad()
+    if len(fraction) == 3 and whole != "0":
+        raise InvoiceError(
+            f"{label} is ambiguous, thousands or decimals: {value!r}")
+    return f"{sign}{whole or '0'}.{fraction}"
+
+
