 LIST_MARKER = re.compile(r"^\s*(?:[-*•]|\d+[.)])\s+")
 
+_NUMBER = r"(?:\d{1,3}(?:[.,]\d{3})+|\d+(?:[.,]\d+)?)(?!\d)"
+# A size such as "under 2 m" or "max 500 gb" is not a price.
+_UNIT = r"(?!\s*(?:mm|cm|m|km|g|kg|mg|l|ml|gb|mb|tb|mah|w|v|hz|inch|inches|in|ft|%)(?![a-z]))"
+
+
+def _money(name):
+    return (
+        rf"(?:[€$£]\s*)?(?P<{name}>{_NUMBER})"
+        r"(?:\s*[€$£]|\s+(?:eur|euro|euros|usd|dollars?|gbp|pounds?)(?![a-z]))?"
+        rf"{_UNIT}"
+    )
+
+
+# (pattern, bound, inclusive)
+_PRICE_BOUNDS = [
+    (re.compile(rf"\b(?:under|below|less than|cheaper than)\s+{_money('n')}", re.I), "max", False),
+    (re.compile(rf"\b(?:max|maximum|up to|at most|no more than|not more than)\.?\s+{_money('n')}", re.I), "max", True),
+    (re.compile(rf"\b(?:over|above|more than)\s+{_money('n')}", re.I), "min", False),
+    (re.compile(rf"\b(?:from|min|minimum|at least)\.?\s+{_money('n')}", re.I), "min", True),
+]
+_PRICE_RANGES = [
+    re.compile(rf"\bbetween\s+{_money('a')}\s+and\s+{_money('b')}", re.I),
+    re.compile(rf"\bfrom\s+{_money('a')}\s+to\s+{_money('b')}", re.I),
+]
+
+
+def _to_number(text):
+    if re.fullmatch(r"\d{1,3}(?:[.,]\d{3})+", text):
+        return float(re.sub(r"[.,]", "", text))
+    return float(text.replace(",", "."))
+
+
+def price_limits(query):
+    """Return a predicate on prices for the limits the search states, or None."""
+    checks = []
+    for pattern, bound, inclusive in _PRICE_BOUNDS:
+        for m in pattern.finditer(query):
+            checks.append((bound, _to_number(m["n"]), inclusive))
+    for pattern in _PRICE_RANGES:
+        for m in pattern.finditer(query):
+            low, high = sorted((_to_number(m["a"]), _to_number(m["b"])))
+            checks.append(("min", low, True))
+            checks.append(("max", high, True))
+    if not checks:
+        return None
+
+    def within(price):
+        for bound, value, inclusive in checks:
+            if bound == "max" and not (price <= value if inclusive else price < value):
+                return False
+            if bound == "min" and not (price >= value if inclusive else price > value):
+                return False
+        return True
+
+    return within
+
 
 def recommend_products(query, catalog, model, limit=5):
     """Return up to `limit` in-stock products for `query`, best first.
 
     `catalog` is a list of dicts with "id", "name", "price", "rating" and "in_stock".
     `model` is a callable taking a prompt string and returning a string.
+    A price limit stated in the query ("under 50", "between 20 and 40") is
+    enforced here: products outside it are neither offered nor returned.
     """
     if limit < 1:
         raise ValueError("limit must be at least 1")
     query = " ".join(query.split())
-    available = {p["id"]: p for p in catalog if p["in_stock"]}
+    within = price_limits(query)
+    available = {
+        p["id"]: p for p in catalog
+        if p["in_stock"] and (within is None or within(p["price"]))
+    }
     if not query or not available:
         return []
 
