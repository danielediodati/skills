+    def test_upper_price_limits(self):
+        for query in ["headphones under 50", "headphones below 50", "max 30 euro",
+                      "up to €30", "less than 30", "under 30€", "max. 30 EUR", "under $30"]:
+            with self.subTest(query=query):
+                self.assertEqual(self.ids_for(query), ["H-200", "C-010", "C-020"])
+
+    def test_upper_limit_values(self):
+        self.assertEqual(self.ids_for("cable under 10"), ["C-010", "C-020"])
