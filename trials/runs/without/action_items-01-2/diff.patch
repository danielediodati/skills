 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _resolve_owner(text: str, attendees: Sequence[str]) -> Optional[str]:
+    """Match `text` to an attendee: by full name, else by a partial name
+    ("Priya") that fits exactly one attendee. An ambiguous one gives None."""
+    key = _key(text)
+    if key in _EMPTY:
+        return None
+    for name in attendees:
+        if _key(name) == key:
+            return name
+    words = set(key.split())
+    matches = [name for name in attendees if words <= set(_key(name).split())]
+    return matches[0] if len(matches) == 1 else None
 
 
